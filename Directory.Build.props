<Project>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TemplateFile Include="**/*.tt"
                  Exclude="$(BaseIntermediateOutputPath)**;$(BaseOutputPath)**;bin/**;obj/**" />
    <Compile Update="@(TemplateFile -> '%(RelativeDir)%(Filename).cs')">
      <DependentUpon>%(Filename).tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Build options -->
  <PropertyGroup>
    <LatestTargetFramework>net11.0</LatestTargetFramework>
    <MinimumTargetFramework>net10.0</MinimumTargetFramework>

    <LatestTargetFrameworks>net11.0;net10.0</LatestTargetFrameworks>
    <LatestTargetFrameworksWindows>net11.0-windows;net10.0-windows</LatestTargetFrameworksWindows>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);NU5104</NoWarn> <!-- Allow prerelease dependencies -->
  </PropertyGroup>

  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <LangVersion>preview</LangVersion>
    <ValidateProjectTargets Condition="$(ValidateProjectTargets) == ''">true</ValidateProjectTargets>

    <IsPackable>False</IsPackable>

    <DefineConstants Condition="$(InvariantGlobalization) == 'true'">$(DefineConstants);INVARIANT_GLOBALIZATION_MODE_ENABLED</DefineConstants>

    <!-- The .NET 11 RC2 SDK publishes a Native AOT project without running its full build, so the XML documentation file
         it then copies from the output directory does not exist (MSB3030): https://github.com/dotnet/sdk/issues/56618 -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
  </PropertyGroup>

  <!-- disable the nullable warnings when compiling for target that haven't annotation -->
  <PropertyGroup Condition="!$(TargetFramework.StartsWith('$(LatestTargetFramework)'))">
    <NoWarn>$(NoWarn);nullable;IDE0370</NoWarn>
  </PropertyGroup>

  <!-- The diagnostics of the experimental APIs of Meziantou.Framework.WebPlatform (Specification/ExperimentalApis.cs,
       docs/experimental-apis.md) only target the consumers of the packages: the projects of the repository use them freely. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Meziantou.Framework.WebPlatform'))">
    <NoWarn>$(NoWarn);WEBPLATEXP0002;WEBPLATEXP0003;WEBPLATEXP0004;WEBPLATEXP0005;WEBPLATEXP0006;WEBPLATEXP0007;WEBPLATEXP0008;WEBPLATEXP0009;WEBPLATEXP0010;WEBPLATEXP0011</NoWarn>
  </PropertyGroup>

  <!-- Package configuration -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/meziantou/Meziantou.Framework</PackageProjectUrl>
  </PropertyGroup>

  <!-- Analyzers -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Polyfill" Version="1.0.169">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
