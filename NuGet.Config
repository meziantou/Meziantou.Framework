<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- dotnet package add/update do not pick a version published less than 7 days ago -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="168" />
  </packageSources>
  <!-- Empty, so that the exceptions of the user or machine configuration files do not bypass the delay -->
  <minPublishAgeExceptions />
</configuration>
