<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Imaging.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.FullPath\Meziantou.Framework.FullPath.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Imaging\Meziantou.Framework.Imaging.csproj" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Meziantou.Framework.Imaging.Tests\Codecs\JpegTestImage.cs" Link="Workloads\TestEncoders\JpegTestImage.cs" />
    <Compile Include="..\..\tests\Meziantou.Framework.Imaging.Tests\Codecs\JpegTestEncodeOptions.cs" Link="Workloads\TestEncoders\JpegTestEncodeOptions.cs" />
    <Compile Include="..\..\tests\Meziantou.Framework.Imaging.Tests\Codecs\JpegTestHuffmanStyle.cs" Link="Workloads\TestEncoders\JpegTestHuffmanStyle.cs" />
    <Compile Include="..\..\tests\Meziantou.Framework.Imaging.Tests\Codecs\JpegTestInkCoding.cs" Link="Workloads\TestEncoders\JpegTestInkCoding.cs" />
    <Compile Include="..\..\tests\Meziantou.Framework.Imaging.Tests\Codecs\JpegTestProgressiveScan.cs" Link="Workloads\TestEncoders\JpegTestProgressiveScan.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AVIF decoding workloads wrap AV1 streams of the golden corpus, written by libaom, into AVIF files -->
    <Compile Include="..\..\fuzz\Meziantou.Framework.Imaging.FuzzTests\FuzzAvifContainer.cs" Link="Workloads\TestEncoders\FuzzAvifContainer.cs" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\av1\lr-switchable-luma-420-384x216.obu" LogicalName="av1/lr-switchable-luma-420-384x216.obu" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\av1\lr-switchable-chroma-444-384x216.obu" LogicalName="av1/lr-switchable-chroma-444-384x216.obu" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\av1\inter-alt-ref-420-8bit-176x144.obu" LogicalName="av1/inter-alt-ref-420-8bit-176x144.obu" />
  </ItemGroup>
</Project>
