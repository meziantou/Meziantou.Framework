<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.UnicodeBenchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.Unicode/Meziantou.Framework.Unicode.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.Unicode.Dictionaries/Meziantou.Framework.Unicode.Dictionaries.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hyphenation patterns of hyph-utf8 that the WebPlatform tests already vendor -->
    <None Include="../../tests/Meziantou.Framework.WebPlatform.SpecData/hyphenation/hyph-utf8/tex/generic/hyph-utf8/patterns/tex/hyph-en-us.tex;../../tests/Meziantou.Framework.WebPlatform.SpecData/hyphenation/hyph-utf8/tex/generic/hyph-utf8/patterns/tex/hyph-fr.tex" Link="hyphenation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
