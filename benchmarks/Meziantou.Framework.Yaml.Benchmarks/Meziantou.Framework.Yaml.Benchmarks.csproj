<Project Sdk="Meziantou.NET.Sdk">

   <PropertyGroup>
     <OutputType>Exe</OutputType>
     <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
   </PropertyGroup>

   <ItemGroup>
     <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
     <!-- Compared with Meziantou.Framework.Yaml by every benchmark class. 'IncludeAssets' keeps the analyzers of the
          package, which the SDK removes by default: the source generator writes StymlBenchmarkYamlContext -->
     <PackageReference Include="Styml" Version="0.1.1" IncludeAssets="all" />
   </ItemGroup>

   <ItemGroup>
     <ProjectReference Include="../../src/Meziantou.Framework.Yaml/Meziantou.Framework.Yaml.csproj" />
     <!-- The source generator of the package, for the rows that use generated metadata -->
     <ProjectReference Include="../../src/Meziantou.Framework.Yaml.SourceGenerator/Meziantou.Framework.Yaml.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
   </ItemGroup>

   <ItemGroup>
     <EmbeddedResource Include="../../tests/Meziantou.Framework.Yaml.Tests/files/styml-corpus/*.yaml" LogicalName="corpus.%(Filename)%(Extension)" />
   </ItemGroup>

</Project>
