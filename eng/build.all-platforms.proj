<Project Sdk="Microsoft.Build.Traversal">
  <PropertyGroup>
    <IsTraversal>true</IsTraversal>
  </PropertyGroup>

  <!-- Same projects as build.proj, minus the platform exclusions: the CI job that computes the
       test matrix runs on Linux, but the matrix must also contain the projects that only run on
       Windows. The per-job traversal still uses build.proj, so those projects are dropped again
       on the runners that cannot run them. -->
  <ItemGroup>
    <ProjectReference Include="../**/*.*proj" Exclude="../eng/*.*proj" />
  </ItemGroup>

  <Import Project="build.exclusions.proj" />
</Project>
