<Project Sdk="Microsoft.Build.Traversal">
  <PropertyGroup>
    <IsTraversal>true</IsTraversal>
  </PropertyGroup>

  <!-- Same projects as build.proj, without the exclusions that only apply to running tests.
       Used by the jobs that must see every project regardless of the runner: the job that
       computes the test matrix (it runs on Linux but feeds the Windows jobs) and the analyzer
       job (it only builds). Jobs that run tests use build.proj instead. -->
  <ItemGroup>
    <ProjectReference Include="../**/*.*proj" Exclude="../eng/*.*proj" />
  </ItemGroup>

  <Import Project="build.exclusions.proj" />
</Project>
