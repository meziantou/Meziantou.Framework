<Project>
  <!-- Projects excluded from the traversal on every platform. Kept separate from
       build.platform-exclusions.proj so build.all-platforms.proj can reuse them.
       The trimming harnesses are published directly by the test_trimming CI jobs; building
       them as part of the traversal would only duplicate that work. -->
  <ItemGroup>
    <ProjectReference Remove="Trimmable/Trimmable.csproj" />
    <ProjectReference Remove="Trimmable.Wpf/Trimmable.Wpf.csproj" />
  </ItemGroup>
</Project>
