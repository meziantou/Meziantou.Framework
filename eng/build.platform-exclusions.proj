<Project>
  <Import Project="build.exclusions.proj" />

  <!-- These projects build everywhere (EnableWindowsTargeting is set in Directory.Build.props),
       but their tests cannot run off Windows: WPF and Windows Forms need the
       Microsoft.WindowsDesktop.App runtime, which only ships for Windows. Only the traversals
       that run tests use this file; build.all-platforms.proj keeps them so they are still
       compiled and analyzed. -->
  <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows')) == false">
    <ProjectReference Remove="../tests/Meziantou.Framework.WPF.Tests/Meziantou.Framework.WPF.Tests.csproj" />
    <ProjectReference Remove="../tests/Meziantou.Framework.Threading.Windows.Tests/Meziantou.Framework.Threading.Windows.Tests.csproj" />
  </ItemGroup>
</Project>
