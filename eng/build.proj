<Project Sdk="Microsoft.Build.Traversal">
  <PropertyGroup>
    <IsTraversal>true</IsTraversal>
    <!-- Removes the projects that cannot run on the current OS. Jobs that only build, or that
         only enumerate the projects for other jobs to run, set it to false. -->
    <SkipUnsupportedPlatforms Condition="'$(SkipUnsupportedPlatforms)' == ''">true</SkipUnsupportedPlatforms>
  </PropertyGroup>

  <!-- eng holds the build infrastructure, including the trimming harnesses that the
       test_trimming jobs publish directly -->
  <ItemGroup>
    <ProjectReference Include="../**/*.*proj" Exclude="../eng/**/*.*proj" />
  </ItemGroup>

  <!-- The WPF and Windows Forms tests need the Microsoft.WindowsDesktop.App runtime, which only
       ships for Windows. They still compile everywhere, so only the traversals that run tests
       drop them. -->
  <ItemGroup Condition="'$(SkipUnsupportedPlatforms)' == 'true' AND $([MSBuild]::IsOsPlatform('Windows')) == false">
    <ProjectReference Remove="../tests/Meziantou.Framework.WPF.Tests/Meziantou.Framework.WPF.Tests.csproj" />
    <ProjectReference Remove="../tests/Meziantou.Framework.Threading.Windows.Tests/Meziantou.Framework.Threading.Windows.Tests.csproj" />
  </ItemGroup>

  <!-- Every test of these suites drives a real database client, which needs ICU, so all of their
       test classes are [RunIf(NotInvariant)]. Under InvariantGlobalization the whole assembly is
       skipped, and a test run where nothing ran fails with "Zero tests ran", so drop the projects
       instead of running them empty. -->
  <ItemGroup Condition="'$(SkipUnsupportedPlatforms)' == 'true' AND '$(InvariantGlobalization)' == 'true'">
    <ProjectReference Remove="../tests/Meziantou.Framework.TdsServer.Tests/Meziantou.Framework.TdsServer.Tests.csproj" />
    <ProjectReference Remove="../tests/Meziantou.Framework.PostgreSqlServer.Tests/Meziantou.Framework.PostgreSqlServer.Tests.csproj" />
  </ItemGroup>
</Project>
