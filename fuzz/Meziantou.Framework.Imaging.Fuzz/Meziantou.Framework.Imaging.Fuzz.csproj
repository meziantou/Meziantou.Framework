<Project Sdk="Meziantou.NET.Sdk">
  <!--
    SharpFuzz targets of Meziantou.Framework.Imaging: the Radiance HDR, DPX and Cineon codecs, the image data of PNG files, the lossy GIF compression, the processing operations and the strokes. The other codecs
    are fuzzed by Meziantou.Framework.Imaging.FuzzTests, over the golden corpus. See fuzz/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- The seeds of imaging-radiance: the Radiance HDR files of the golden corpus, valid, invalid, unsupported and over the limits -->
    <SeedPicture Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\hdr\*.hdr;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\hdr\*.hdr;..\..\tests\Meziantou.Framework.Imaging.Fixtures\limit\hdr\*.hdr" />
    <EmbeddedResource Include="@(SeedPicture)" LogicalName="Seeds/radiance/%(Filename)%(Extension)" Link="Seeds\radiance\%(Filename)%(Extension)" />

    <!-- The seeds of imaging-dpx and imaging-cineon: the DPX and Cineon files of the golden corpus, valid, invalid, unsupported and over the limits -->
    <SeedDpx Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\dpx\*.dpx;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\dpx\*.dpx;..\..\tests\Meziantou.Framework.Imaging.Fixtures\limit\dpx\*.dpx" />
    <EmbeddedResource Include="@(SeedDpx)" LogicalName="Seeds/dpx/%(Filename)%(Extension)" Link="Seeds\dpx\%(Filename)%(Extension)" />
    <SeedCineon Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\cin\*.cin;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\cin\*.cin" />
    <EmbeddedResource Include="@(SeedCineon)" LogicalName="Seeds/cineon/%(Filename)%(Extension)" Link="Seeds\cineon\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.Fuzzing\Meziantou.Framework.Fuzzing.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Imaging\Meziantou.Framework.Imaging.csproj" />
  </ItemGroup>
</Project>
