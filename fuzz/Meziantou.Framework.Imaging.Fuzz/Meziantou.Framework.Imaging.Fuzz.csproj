<Project Sdk="Meziantou.NET.Sdk">
  <!--
    SharpFuzz targets of Meziantou.Framework.Imaging: the Radiance HDR, PSD, DDS, DPX, Cineon and KTX 2.0 codecs, the DNG decoder, the BC1 to BC7 block decoders, the image data of PNG files, the lossy GIF compression, the JPEG 2000 encoder, the processing operations, the strokes, the optimal line breaking, the ICC profiles of color conversion, and the layers and optimized animations of JPEG XL. The other codecs
    are fuzzed by Meziantou.Framework.Imaging.FuzzTests, over the golden corpus. See fuzz/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- The seeds of imaging-radiance: the Radiance HDR files of the golden corpus, valid, invalid, unsupported and over the limits -->
    <SeedPicture Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\hdr\*.hdr;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\hdr\*.hdr;..\..\tests\Meziantou.Framework.Imaging.Fixtures\limit\hdr\*.hdr" />
    <EmbeddedResource Include="@(SeedPicture)" LogicalName="Seeds/radiance/%(Filename)%(Extension)" Link="Seeds\radiance\%(Filename)%(Extension)" />
    <!-- The seeds of imaging-psd: the PSD and PSB files of the golden corpus, valid, invalid and unsupported (PSB files are embedded with the extension .psd) -->
    <SeedDocument Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\psd\*.psd;..\..\tests\Meziantou.Framework.Imaging.Fixtures\psd\*.psb;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\psd\*.psd" />
    <EmbeddedResource Include="@(SeedDocument)" LogicalName="Seeds/psd/%(Filename).psd" Link="Seeds\psd\%(Filename)%(Extension)" />
    <!-- The seeds of imaging-dng: the DNG files of the golden corpus, valid, invalid, unsupported and over the limits -->
    <SeedDng Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\dng\*.dng;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\dng\*.dng;..\..\tests\Meziantou.Framework.Imaging.Fixtures\limit\dng\*.dng" />
    <EmbeddedResource Include="@(SeedDng)" LogicalName="Seeds/dng/%(Filename)%(Extension)" Link="Seeds\dng\%(Filename)%(Extension)" />
    <!-- The seeds of imaging-dds and imaging-dds-blocks: the DDS files of the golden corpus, valid, invalid, unsupported and over the limits -->
    <SeedTexture Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\dds\*.dds;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\dds\*.dds;..\..\tests\Meziantou.Framework.Imaging.Fixtures\limit\dds\*.dds" />
    <EmbeddedResource Include="@(SeedTexture)" LogicalName="Seeds/dds/%(Filename)%(Extension)" Link="Seeds\dds\%(Filename)%(Extension)" />

    <!-- The seeds of imaging-dpx and imaging-cineon: the DPX and Cineon files of the golden corpus, valid, invalid, unsupported and over the limits -->
    <SeedDpx Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\dpx\*.dpx;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\dpx\*.dpx;..\..\tests\Meziantou.Framework.Imaging.Fixtures\limit\dpx\*.dpx" />
    <EmbeddedResource Include="@(SeedDpx)" LogicalName="Seeds/dpx/%(Filename)%(Extension)" Link="Seeds\dpx\%(Filename)%(Extension)" />
    <SeedCineon Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\cin\*.cin;..\..\tests\Meziantou.Framework.Imaging.Fixtures\invalid\cin\*.cin" />
    <EmbeddedResource Include="@(SeedCineon)" LogicalName="Seeds/cineon/%(Filename)%(Extension)" Link="Seeds\cineon\%(Filename)%(Extension)" />

    <!-- The seeds of imaging-ktx2: the conformance files of the KTX 2.0 tests, written by KTX-Software, astcenc and basisu -->
    <SeedKtx2 Include="..\..\tests\Meziantou.Framework.Imaging.Ktx2.Tests\Files\*.ktx2" />
    <EmbeddedResource Include="@(SeedKtx2)" LogicalName="Seeds/ktx2/%(Filename)%(Extension)" Link="Seeds\ktx2\%(Filename)%(Extension)" />

    <!-- The seeds of imaging-jxl-layers-load, after the layered files it generates: the JPEG XL files of the golden corpus -->
    <JpegXlSeed Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\jxl\*.jxl" />
    <EmbeddedResource Include="@(JpegXlSeed)" LogicalName="Seeds/jxl/%(Filename)%(Extension)" Link="Seeds\jxl\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seeds of imaging-icc-named-colors and imaging-icc-conversion: the ICC profiles of the golden corpus (versions 2, 4 and 5, named colors) -->
    <SeedProfile Include="..\..\tests\Meziantou.Framework.Imaging.Fixtures\icc\profiles\*.icc" />
    <EmbeddedResource Include="@(SeedProfile)" LogicalName="Seeds/icc/%(Filename)%(Extension)" Link="Seeds\icc\%(Filename)%(Extension)" />

    <!-- The PostScript Type 1 font of the font tests: the font of imaging-line-breaking -->
    <Compile Include="..\..\tools\Meziantou.Framework.Imaging.CorpusGenerator\Common\FontType1Writer.cs" Link="Shared\FontType1Writer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.Fuzzing\Meziantou.Framework.Fuzzing.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Imaging\Meziantou.Framework.Imaging.csproj" />
  </ItemGroup>
</Project>
