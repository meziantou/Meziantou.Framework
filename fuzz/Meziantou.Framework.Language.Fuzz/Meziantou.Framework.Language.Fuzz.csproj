<Project Sdk="Meziantou.NET.Sdk">
  <!-- SharpFuzz targets of the Meziantou.Framework.Language.* parsers. See fuzz/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- The conformance corpora of the unit tests are the seeds -->
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Language.Css.Tests\files\css-parsing-tests\*.json" LogicalName="css-parsing-tests.%(Filename)%(Extension)" Link="Seeds\css-parsing-tests\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Language.Toml.Tests\files\toml-test\cases.json" LogicalName="toml-test.cases.json" Link="Seeds\toml-test.cases.json" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Language.Regex.Tests\Corpus\NetValid.txt" LogicalName="regex.NetValid.txt" Link="Seeds\regex\NetValid.txt" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Language.Regex.Tests\Corpus\NetInvalid.txt" LogicalName="regex.NetInvalid.txt" Link="Seeds\regex\NetInvalid.txt" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Language.Regex.Tests\Corpus\JavaScriptConformance.jsonl" LogicalName="regex.JavaScriptConformance.jsonl" Link="Seeds\regex\JavaScriptConformance.jsonl" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Language.Regex.Tests\Corpus\PcreConformance.jsonl" LogicalName="regex.PcreConformance.jsonl" Link="Seeds\regex\PcreConformance.jsonl" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Language.Regex.Tests\Corpus\PosixConformance.jsonl" LogicalName="regex.PosixConformance.jsonl" Link="Seeds\regex\PosixConformance.jsonl" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.Fuzzing\Meziantou.Framework.Fuzzing.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Language.Css\Meziantou.Framework.Language.Css.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Language.Ini\Meziantou.Framework.Language.Ini.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Language.Json\Meziantou.Framework.Language.Json.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Language.Regex\Meziantou.Framework.Language.Regex.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Language.Shell\Meziantou.Framework.Language.Shell.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Language.Toml\Meziantou.Framework.Language.Toml.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Language.Xml\Meziantou.Framework.Language.Xml.csproj" />
  </ItemGroup>
</Project>
