<Project Sdk="Meziantou.NET.Sdk">
  <!-- SharpFuzz targets of Meziantou.Framework.Markdown. See fuzz/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- The examples of the specifications (CommonMark and the extensions) are the seeds -->
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Markdown.Tests\Specs\*.md" Exclude="..\..\tests\Meziantou.Framework.Markdown.Tests\Specs\readme.md" LogicalName="Specs.%(Filename)%(Extension)" Link="Seeds\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Markdown.Tests\NormalizeSpecs\*.md" LogicalName="Specs.Normalize%(Filename)%(Extension)" Link="Seeds\Normalize%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.Fuzzing\Meziantou.Framework.Fuzzing.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Markdown\Meziantou.Framework.Markdown.csproj" />
  </ItemGroup>
</Project>
