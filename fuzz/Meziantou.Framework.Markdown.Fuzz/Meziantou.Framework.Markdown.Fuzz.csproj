<Project Sdk="Meziantou.NET.Sdk">
  <!-- SharpFuzz targets of Meziantou.Framework.Markdown. See fuzz/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- The invariants every tree of Meziantou.Framework.Language shares -->
    <Compile Include="..\Meziantou.Framework.Language.Fuzz\SyntaxTreeInvariants.cs" Link="SyntaxTreeInvariants.cs" />
    <Compile Include="..\Meziantou.Framework.Language.Fuzz\TreeShape.cs" Link="TreeShape.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The examples of the specifications of the unit tests are the seeds -->
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Markdown.Tests\Specs\CommonMark.md" LogicalName="markdown.CommonMark.md" Link="Seeds\CommonMark.md" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Markdown.Tests\Specs\GfmExtensions.md" LogicalName="markdown.GfmExtensions.md" Link="Seeds\GfmExtensions.md" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.Markdown.Tests\Specs\Extensions\*.md" Exclude="..\..\tests\Meziantou.Framework.Markdown.Tests\Specs\Extensions\readme.md" LogicalName="markdown.extensions.%(Filename).md" Link="Seeds\Extensions\%(Filename).md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.Fuzzing\Meziantou.Framework.Fuzzing.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Markdown\Meziantou.Framework.Markdown.csproj" />
  </ItemGroup>
</Project>
