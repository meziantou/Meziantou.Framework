<Project Sdk="Meziantou.NET.Sdk">
  <!-- SharpFuzz targets of Meziantou.Framework.TaggedValues.Analyzer. See fuzz/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- The comments and the sources of the unit tests are the seeds -->
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.TaggedValues.Analyzer.Tests\LocalTagTests.cs" LogicalName="LocalTagTests.cs" Link="Seeds\LocalTagTests.cs" />
    <EmbeddedResource Include="..\..\tests\Meziantou.Framework.TaggedValues.Analyzer.Tests\InvalidAnnotationRuleTests.cs" LogicalName="InvalidAnnotationRuleTests.cs" Link="Seeds\InvalidAnnotationRuleTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.Fuzzing\Meziantou.Framework.Fuzzing.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.TaggedValues.Analyzer\Meziantou.Framework.TaggedValues.Analyzer.csproj" />
  </ItemGroup>
</Project>
