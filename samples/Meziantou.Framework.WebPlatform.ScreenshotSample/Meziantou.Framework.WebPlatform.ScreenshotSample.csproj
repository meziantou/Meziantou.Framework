<Project Sdk="Meziantou.NET.Sdk">
  <!-- Takes a screenshot of a page with the managed rendering backend (see Program.cs). The rendering backend is
       AOT-compatible: the sample can be published with Native AOT, and the trimming and AOT warnings are errors -->
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform\Meziantou.Framework.WebPlatform.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.Imaging\Meziantou.Framework.WebPlatform.Imaging.csproj" />
  </ItemGroup>
</Project>
