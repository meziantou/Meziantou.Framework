<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>True</IsPackable>
    <EnablePackageValidation Condition="'$(EnablePackageValidation)' == ''">true</EnablePackageValidation>

    <!-- The libraries support trimming unless they opt out with IsTrimmable=false. Directory.Build.targets turns it off for the target frameworks that do not support it -->
    <IsTrimmable Condition="'$(IsTrimmable)' == ''">true</IsTrimmable>

    <PublicApiGeneratorGenerateOnBuild Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(PublicApiGeneratorGenerateOnBuild)' == ''">false</PublicApiGeneratorGenerateOnBuild>
    <PublicApiGeneratorVerifyNoChangeOnBuild Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(PublicApiGeneratorVerifyNoChangeOnBuild)' == ''">false</PublicApiGeneratorVerifyNoChangeOnBuild>

    <PublicApiGeneratorGenerateOnBuild Condition="'$(PublicApiGeneratorGenerateOnBuild)' == ''">true</PublicApiGeneratorGenerateOnBuild>
    <PublicApiGeneratorVerifyNoChangeOnBuild Condition="'$(PublicApiGeneratorVerifyNoChangeOnBuild)' == ''">false</PublicApiGeneratorVerifyNoChangeOnBuild>
    <PublicApiGeneratorFileLayout Condition="'$(PublicApiGeneratorFileLayout)' == ''">SingleFile</PublicApiGeneratorFileLayout>
    <PublicApiGeneratorIncludeAutoGeneratedComment Condition="'$(PublicApiGeneratorIncludeAutoGeneratedComment)' == ''">true</PublicApiGeneratorIncludeAutoGeneratedComment>
    <PublicApiGeneratorIncludeAssemblyReferences Condition="'$(PublicApiGeneratorIncludeAssemblyReferences)' == ''">true</PublicApiGeneratorIncludeAssemblyReferences>
  </PropertyGroup>

</Project>
