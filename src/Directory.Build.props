<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>True</IsPackable>
    <EnablePackageValidation Condition="'$(EnablePackageValidation)' == ''">true</EnablePackageValidation>

    <PublicApiGeneratorGenerateOnBuild Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(PublicApiGeneratorGenerateOnBuild)' == ''">false</PublicApiGeneratorGenerateOnBuild>
    <PublicApiGeneratorVerifyNoChangeOnBuild Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(PublicApiGeneratorVerifyNoChangeOnBuild)' == ''">false</PublicApiGeneratorVerifyNoChangeOnBuild>

    <PublicApiGeneratorGenerateOnBuild Condition="'$(PublicApiGeneratorGenerateOnBuild)' == ''">true</PublicApiGeneratorGenerateOnBuild>
    <PublicApiGeneratorVerifyNoChangeOnBuild Condition="'$(PublicApiGeneratorVerifyNoChangeOnBuild)' == ''">false</PublicApiGeneratorVerifyNoChangeOnBuild>
    <PublicApiGeneratorFileLayout Condition="'$(PublicApiGeneratorFileLayout)' == ''">SingleFile</PublicApiGeneratorFileLayout>
    <PublicApiGeneratorIncludeAutoGeneratedComment Condition="'$(PublicApiGeneratorIncludeAutoGeneratedComment)' == ''">true</PublicApiGeneratorIncludeAutoGeneratedComment>
  </PropertyGroup>

  <!--
    Microsoft.Sbom.Targets scans SbomGenerationBuildComponentPath with Component Detection to list the package
    dependencies in the SBOM. It defaults to the project directory and never finds anything here: every generated
    manifest holds a single package (the package itself) and no dependency relationship, and the scan logs
    "There were no packages detected during the generation workflow" for every project. On the CI agents the
    ecosystem detectors do find their tools (mvn, pip, ...) and shell out to them, which is where 'dotnet pack'
    hangs when the whole repository is packed. Point the scan at an empty directory so it stays a no-op.
    This must be set here and not in Directory.Build.targets: Microsoft.Sbom.Targets assigns the default in its
    own targets file, which is imported first and would win.
  -->
  <PropertyGroup>
    <SbomGenerationBuildComponentPath Condition="'$(SbomGenerationBuildComponentPath)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)', 'sbom-component-scan'))</SbomGenerationBuildComponentPath>
  </PropertyGroup>

</Project>
