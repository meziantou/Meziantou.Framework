@typeparam TRowData
@using Meziantou.AspNetCore.Components.Internals
@using Microsoft.AspNetCore.Components.Rendering
@*
    <CascadingValue> allows descendant components (defined in ChildContent) to receive the specified value.
    Child components need to declare a cascading parameter with the same type as "Value" (i.e. Grid<TRowData>).
    This allows GridColumn to get the Grid instance by using a CascadingParameter

        [CascadingParameter]public Grid<TRowData> OwnerGrid { get; set; }

    IsFixed="true" indicates that "Value" will not change. This is a
    performance optimization that allows the framework to skip setting up
    change notifications.
*@
@RenderGrid

@code {
    /// <summary>Gets or sets additional attributes to apply to the table element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? TableAttributes { get; set; }

    /// <summary>Gets or sets the collection of items to display in the grid.</summary>
    [Parameter]
    public IEnumerable<TRowData>? Items { get; set; }

    /// <summary>Gets or sets the child content, which should contain <see cref="DataGridColumn{TRowData}"/> components.</summary>
    // This fragment should contains all the GridColumn
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets a function to determine the CSS class for each row based on the row data and index.</summary>
    [Parameter]
    public Func<TRowData, int, string>? RowClass { get; set; }

    /// <summary>
    /// Gets or sets a function that returns a stable, unique key for each row, used as the <c>@key</c> of the row element.
    /// Keys must be unique among the rendered rows; a duplicate key makes the renderer throw.
    /// When not specified, the row index is used, which is always unique.
    /// </summary>
    [Parameter]
    public Func<TRowData, object>? RowKey { get; set; }

    private void RenderGrid(RenderTreeBuilder builder)
    {
        builder.OpenComponent<CascadingValue<DataGrid<TRowData>>>(0);
        builder.AddComponentParameter(1, nameof(CascadingValue<DataGrid<TRowData>>.IsFixed), true);
        builder.AddComponentParameter(2, nameof(CascadingValue<DataGrid<TRowData>>.Value), this);
        builder.AddComponentParameter(3, nameof(CascadingValue<DataGrid<TRowData>>.ChildContent), (RenderFragment)(content =>
        {
            // The columns and the table are in a component keyed by a generation: a new generation recreates the columns,
            // so they all render again, in the order of ChildContent
            content.OpenComponent<DeferredContent>(0);
            content.SetKey(columnsGeneration);
            content.AddComponentParameter(1, nameof(DeferredContent.ChildContent), (RenderFragment)RenderColumnsAndTable);
            content.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private void RenderColumnsAndTable(RenderTreeBuilder content)
    {
        // The columns register themselves while they render, in the order of ChildContent. Collecting them again on
        // each render keeps that order when a column is removed and added back (for instance with @if). The table
        // renders after them, in a child component.
        StartCollectingColumns();
        content.AddContent(0, ChildContent);
        content.OpenComponent<DeferredContent>(1);
        content.AddComponentParameter(2, nameof(DeferredContent.ChildContent), (RenderFragment)RenderTable);
        content.CloseComponent();
    }

    private void RenderTable(RenderTreeBuilder __builder)
    {
        FinishCollectingColumns();
        <table @attributes="@TableAttributes">
            <thead>
                <tr>
                    @foreach (var column in columns)
                    {
                        @column.HeaderTemplate
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    if (Items != null)
                    {
                        var index = 0;
                        foreach (var item in Items)
                        {
                            var rowIndex = index;
                            @* Use @key to help the diff algorithm when updating the collection. The key must be unique among
                               siblings, so it falls back to the row index unless the caller supplies a real key. *@
                            <tr @key="RowKey is null ? rowIndex : RowKey(item)" class="@(RowClass?.Invoke(item, rowIndex))">
                                @foreach (var column in columns)
                                {
                                    @column.CellTemplate(item)
                                }
                            </tr>
                            index++;
                        }
                    }
                }
            </tbody>
        </table>
    }

    private readonly List<DataGridColumn<TRowData>> columns = new List<DataGridColumn<TRowData>>();
    private readonly List<DataGridColumn<TRowData>> liveColumns = new List<DataGridColumn<TRowData>>();
    private List<DataGridColumn<TRowData>> previousColumns = new List<DataGridColumn<TRowData>>();
    private bool collectingColumns;
    private int columnsGeneration;

    private void StartCollectingColumns()
    {
        previousColumns = new List<DataGridColumn<TRowData>>(columns);
        columns.Clear();
        collectingColumns = true;
    }

    private void FinishCollectingColumns()
    {
        collectingColumns = false;

        // A column whose parameters did not change (for instance a Title only) does not render again: it keeps the
        // position it had after the column that preceded it
        var hasNewColumn = columns.Exists(column => !previousColumns.Contains(column));
        var hasSkippedColumn = false;
        for (var i = 0; i < previousColumns.Count; i++)
        {
            var column = previousColumns[i];
            if (columns.Contains(column) || !liveColumns.Contains(column))
                continue;

            hasSkippedColumn = true;

            var insertAt = 0;
            for (var j = i - 1; j >= 0; j--)
            {
                var index = columns.IndexOf(previousColumns[j]);
                if (index >= 0)
                {
                    insertAt = index + 1;
                    break;
                }
            }

            columns.Insert(insertAt, column);
        }

        // The position of a new column among the columns that did not render is unknown (a column shown by @if before
        // them): render the grid again with new columns, which all render in the order of ChildContent
        if (hasNewColumn && hasSkippedColumn)
        {
            columnsGeneration++;
            StateHasChanged();
        }
    }

    // DataGridColumn calls this method when it is initialized
    internal void RegisterColumn(DataGridColumn<TRowData> column) => liveColumns.Add(column);

    // DataGridColumn calls this method while it renders. The columns render after the grid and before the table
    // (DeferredContent), so the table uses the columns of the current ChildContent, in their order. This must not rely on
    // OnAfterRender: static server-side rendering never calls it, which would leave the table permanently empty.
    internal void AddColumn(DataGridColumn<TRowData> column)
    {
        if (collectingColumns && !columns.Contains(column))
        {
            columns.Add(column);
        }
    }

    internal void RemoveColumn(DataGridColumn<TRowData> column)
    {
        liveColumns.Remove(column);
        columns.Remove(column);
    }
}