<Project Sdk="Meziantou.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- TimeZoneService resolves the IANA time zone of the browser -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>

    <Version>3.0.11</Version>
    <IsTrimmable>false</IsTrimmable>
    <Description>Components and services for Blazor</Description>
    <PackageTags>aspnetcore, blazor, components, razor, ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>


</Project>
