<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Version>0.1.0</Version>
    <IsTrimmable>false</IsTrimmable>
    <!-- Microsoft.JSInterop does not pass trim analysis (IL2065/IL2111) -->
    <SkipTrimmableValidation>true</SkipTrimmableValidation>
    <Description>Tests of ASP.NET Core applications and Blazor components in a managed browser engine (Meziantou.Framework.WebPlatform): Blazor components rendered in a real DOM, and the pages of an application in memory (MVC, Razor Pages, Blazor, minimal APIs...), with CSS layout, scripts, user input (mouse, keyboard, touch), DOM and accessibility snapshots, and screenshots.</Description>
    <PackageTags>aspnetcore, blazor, components, testing, e2e, browser, dom, screenshot</PackageTags>
    <!-- The URLs are strings, as in the DOM and NavigationManager -->
    <NoWarn>$(NoWarn);CA1054;CA1056</NoWarn>
    <!-- The Blazor renderer reads the render batches: the types of Microsoft.AspNetCore.Components.RenderTree are its input -->
    <NoWarn>$(NoWarn);BL0006</NoWarn>
    <!-- The test host implements the JavaScript interop: BL0016 is for the components that call it -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The in-memory server (TestServer) and the Blazor components; Microsoft.AspNetCore.TestHost references it too -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.WebPlatform\Meziantou.Framework.WebPlatform.csproj" />
    <ProjectReference Include="..\Meziantou.Framework.WebPlatform.Imaging\Meziantou.Framework.WebPlatform.Imaging.csproj" />
    <ProjectReference Include="..\Meziantou.Framework.WebPlatform.JavaScript\Meziantou.Framework.WebPlatform.JavaScript.csproj" />
  </ItemGroup>

</Project>
