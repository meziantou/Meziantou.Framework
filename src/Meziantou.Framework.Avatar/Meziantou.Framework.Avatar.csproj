<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <!-- The initials are computed from the normalized name -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework</RootNamespace>
    <Version>2.1.7</Version>
    <Description>Generate deterministic avatar images from names and bigrams, as SVG or as vector scenes to draw as PNG</Description>
    <PackageTags>avatar, identicon, initials, svg, png, image</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- AvatarGenerator.CreateScene -->
    <ProjectReference Include="../Meziantou.Framework.VectorGraphics/Meziantou.Framework.VectorGraphics.csproj" />
  </ItemGroup>

</Project>
