<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Barcodes</RootNamespace>
    <Version>1.0.6</Version>
    <Description>QR code, Data Matrix, PDF417, Aztec and barcode generation as vector scenes (SVG, and images or PDF with the bridge packages) and console text, with logos and human-readable text in OCR-A or OCR-B, and decoders</Description>
    <PackageTags>qrcode, barcode, datamatrix, pdf417, aztec, svg, vector, console, ocr-a, ocr-b, decoder, reader</PackageTags>
    <NoWarn>$(NoWarn);CA1814</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scenes every renderer draws, and the SVG writer -->
    <ProjectReference Include="..\Meziantou.Framework.VectorGraphics\Meziantou.Framework.VectorGraphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GS1 Barcode Syntax Dictionary, as GS1 published it (see THIRD-PARTY-NOTICES.md) -->
    <EmbeddedResource Include="Internal\Gs1\gs1-syntax-dictionary.txt" LogicalName="Meziantou.Framework.Barcodes.gs1-syntax-dictionary.txt" />
    <!-- Generated by tools/Meziantou.Framework.Imaging.Barcodes.FontGenerator: see its readme -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Meziantou.Framework.Barcodes.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Barcodes.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Barcodes.Fuzz" />
  </ItemGroup>

</Project>
