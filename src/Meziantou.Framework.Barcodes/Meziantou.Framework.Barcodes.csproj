<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Barcodes</RootNamespace>
    <Version>1.0.3</Version>
    <Description>QR code, Data Matrix, PDF417, Aztec and barcode generation with SVG, PNG, and console renderers, and decoders</Description>
    <PackageTags>qrcode, barcode, datamatrix, pdf417, aztec, svg, png, console, decoder, reader</PackageTags>
    <NoWarn>$(NoWarn);CA1814</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CRC-32 of PNG chunks -->
    <ProjectReference Include="..\Meziantou.Framework.Hashing\Meziantou.Framework.Hashing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GS1 Barcode Syntax Dictionary, as GS1 published it (see THIRD-PARTY-NOTICES.md) -->
    <EmbeddedResource Include="Internal\Gs1\gs1-syntax-dictionary.txt" LogicalName="Meziantou.Framework.Barcodes.gs1-syntax-dictionary.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Barcodes.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Barcodes.Fuzz" />
  </ItemGroup>

</Project>
