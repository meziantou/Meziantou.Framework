<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Charts</RootNamespace>
    <Version>1.0.2</Version>
    <Description>Grammar-of-graphics chart library that renders deterministic SVG: bar, line, area, scatter, pie, radar, gauge, packed circles, treemap, sunburst, histogram, box plot, heatmap, waterfall, funnel, candlestick, choropleth maps and more, built from marks, scales, coordinates and transforms.</Description>
    <PackageTags>chart;charts;plot;svg;graph;visualization;grammar-of-graphics;bar-chart;line-chart;pie-chart;treemap;sunburst;histogram;map;choropleth;geojson</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scene, the SVG writer and the text measurers -->
    <ProjectReference Include="../Meziantou.Framework.VectorGraphics/Meziantou.Framework.VectorGraphics.csproj" />

    <!-- The features, geometries and projections of the maps -->
    <ProjectReference Include="../Meziantou.Framework.Geo/Meziantou.Framework.Geo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rounds the numbers of the scales like the SVG writer rounds the coordinates -->
    <Compile Include="../Meziantou.Framework.VectorGraphics/Internals/DecimalRounding.cs" Link="Internals/DecimalRounding.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Meziantou.Framework.Geo" />
    <Using Include="Meziantou.Framework.VectorGraphics" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests check the layout algorithms with exact values -->
    <InternalsVisibleTo Include="Meziantou.Framework.Charts.Tests" />
  </ItemGroup>

</Project>
