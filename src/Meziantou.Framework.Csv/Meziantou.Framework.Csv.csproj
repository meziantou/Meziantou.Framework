<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Description>High-performance SIMD CSV reader and writer for UTF-16 and UTF-8 data, with a System.Text.Json-style serializer and a source generator for Native AOT</Description>
    <PackageTags>csv, tsv, parser, reader, writer, serializer, simd, nativeaot</PackageTags>
    <Version>6.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Csv.SourceGenerator/Meziantou.Framework.Csv.SourceGenerator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)/../../Meziantou.Framework.Csv.SourceGenerator/$(Configuration.ToLowerInvariant())_netstandard2.0/Meziantou.Framework.Csv.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="Meziantou.Framework.Csv.targets" Pack="true" PackagePath="buildTransitive/Meziantou.Framework.Csv.targets" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Substitutions.xml" LogicalName="ILLink.Substitutions.xml" />
  </ItemGroup>

</Project>
