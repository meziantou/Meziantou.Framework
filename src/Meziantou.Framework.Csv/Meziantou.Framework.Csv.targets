<Project>
  <PropertyGroup>
    <!--
      Feature switches for trimming / NativeAOT.

      Meziantou.Framework.Csv follows the "feature switches" guidance from dotnet/runtime:
      - values are provided to the runtime via runtimeconfig.json using RuntimeHostConfigurationOption
      - values are also provided to the trimmer when Trim="true"
    -->

    <!--
      By default, disable reflection-based serialization when publishing with NativeAOT.
      Consumers can override by setting MeziantouFrameworkCsvIsReflectionEnabledByDefault explicitly.
    -->
    <MeziantouFrameworkCsvIsReflectionEnabledByDefault Condition="'$(MeziantouFrameworkCsvIsReflectionEnabledByDefault)' == '' and ( '$(PublishAot)' == 'true' or '$(NativeAot)' == 'true' )">false</MeziantouFrameworkCsvIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(MeziantouFrameworkCsvIsReflectionEnabledByDefault)' != ''">
    <RuntimeHostConfigurationOption Include="Meziantou.Framework.Csv.Serialization.CsvSerializer.IsReflectionEnabledByDefault"
                                   Value="$(MeziantouFrameworkCsvIsReflectionEnabledByDefault)"
                                   Trim="true" />
  </ItemGroup>
</Project>

