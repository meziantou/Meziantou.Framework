<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsTrimmable>false</IsTrimmable>
    <Version>2.0.24</Version>
    <Description>CLI tool to update dependencies in source repositories</Description>
    <PackageTags>dependencies, scanner, nuget, npm, docker, cli, dotnet-tool</PackageTags>
    <IncludeSharedHttpClient>true</IncludeSharedHttpClient>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Configuration" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <!-- NuGet.Protocol depends on a version vulnerable to GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework/Meziantou.Framework.csproj" />
    <ProjectReference Include="../Meziantou.Framework.DependencyScanning/Meziantou.Framework.DependencyScanning.csproj" />
    <ProjectReference Include="../Meziantou.Framework.FullPath/Meziantou.Framework.FullPath.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Globbing/Meziantou.Framework.Globbing.csproj" />
    <ProjectReference Include="../Meziantou.Framework.ProcessWrapper/Meziantou.Framework.ProcessWrapper.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Versioning/Meziantou.Framework.Versioning.csproj" />
  </ItemGroup>

</Project>
