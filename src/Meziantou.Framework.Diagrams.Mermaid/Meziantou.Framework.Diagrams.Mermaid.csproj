<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Diagrams.Mermaid</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Reads and writes the Mermaid text format for Meziantou.Framework.Diagrams: the 31 diagram types of Meziantou.Framework.Diagrams, with the front matter, the directives and the themes of Mermaid.</Description>
    <PackageTags>mermaid;mermaid-js;diagram;diagrams;svg;flowchart;uml;parser;markdown</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Diagrams/Meziantou.Framework.Diagrams.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Yaml/Meziantou.Framework.Yaml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Meziantou.Framework.VectorGraphics" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Diagrams.Mermaid.Tests" />
  </ItemGroup>

</Project>
