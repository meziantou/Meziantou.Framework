<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Diagrams</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Diagrams written as deterministic SVG, inspired by Mermaid: 31 diagram types of Mermaid, from flowcharts, class, sequence, entity relationship, C4 and architecture diagrams to Gantt charts, mind maps, pie charts, XY charts, sankey diagrams, Venn diagrams and Wardley maps, laid out automatically, with the themes of Mermaid.</Description>
    <PackageTags>diagram;diagrams;svg;flowchart;uml;class-diagram;state-diagram;er-diagram;sequence-diagram;c4;architecture;gantt;mindmap;pie-chart;sankey;treemap;venn;graph-layout;mermaid</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.VectorGraphics/Meziantou.Framework.VectorGraphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Meziantou.Framework.VectorGraphics" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests check the layout algorithms with exact values -->
    <InternalsVisibleTo Include="Meziantou.Framework.Diagrams.Tests" />

    <!-- The fuzz targets check the invariants of the layout -->
    <InternalsVisibleTo Include="Meziantou.Framework.Diagrams.Fuzz" />
  </ItemGroup>

</Project>
