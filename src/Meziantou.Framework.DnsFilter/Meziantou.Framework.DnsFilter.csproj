<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <!-- Converts internationalized domain names with IdnMapping -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Version>2.0.4</Version>
    <IsTrimmable>true</IsTrimmable>
    <Description>DNS filter list parser and matching engine supporting hosts files, domains-only lists, and AdGuard/Adblock DNS filtering syntax</Description>
    <PackageTags>dns, filter, adblock, adguard, hosts, blocklist</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.DnsFilter.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Dns.Fuzz" />
  </ItemGroup>

</Project>
