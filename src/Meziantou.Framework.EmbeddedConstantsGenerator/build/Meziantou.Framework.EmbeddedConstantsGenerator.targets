<Project>
  <PropertyGroup>
    <_EmbeddedConstantsTaskAssemblyPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tasks', 'Meziantou.Framework.EmbeddedConstantsGenerator.dll'))</_EmbeddedConstantsTaskAssemblyPath>

    <Meziantou_EmbeddedConstantsNamespace Condition="'$(Meziantou_EmbeddedConstantsNamespace)' == '' and '$(EmbeddedConstantsNamespace)' != ''">$(EmbeddedConstantsNamespace)</Meziantou_EmbeddedConstantsNamespace>
    <Meziantou_EmbeddedConstantsClassName Condition="'$(Meziantou_EmbeddedConstantsClassName)' == '' and '$(EmbeddedConstantsClassName)' != ''">$(EmbeddedConstantsClassName)</Meziantou_EmbeddedConstantsClassName>
    <Meziantou_EmbeddedConstantsClassVisibility Condition="'$(Meziantou_EmbeddedConstantsClassVisibility)' == '' and '$(EmbeddedConstantsClassVisibility)' != ''">$(EmbeddedConstantsClassVisibility)</Meziantou_EmbeddedConstantsClassVisibility>
    <Meziantou_EmbeddedConstantsMemberVisibility Condition="'$(Meziantou_EmbeddedConstantsMemberVisibility)' == '' and '$(EmbeddedConstantsMemberVisibility)' != ''">$(EmbeddedConstantsMemberVisibility)</Meziantou_EmbeddedConstantsMemberVisibility>
    <Meziantou_EmbeddedConstantsOutputPath Condition="'$(Meziantou_EmbeddedConstantsOutputPath)' == '' and '$(EmbeddedConstantsOutputPath)' != ''">$(EmbeddedConstantsOutputPath)</Meziantou_EmbeddedConstantsOutputPath>

    <Meziantou_EmbeddedConstantsNamespace Condition="'$(Meziantou_EmbeddedConstantsNamespace)' == '' and '$(RootNamespace)' != ''">$(RootNamespace)</Meziantou_EmbeddedConstantsNamespace>
    <Meziantou_EmbeddedConstantsNamespace Condition="'$(Meziantou_EmbeddedConstantsNamespace)' == ''">$(MSBuildProjectName)</Meziantou_EmbeddedConstantsNamespace>
    <Meziantou_EmbeddedConstantsClassName Condition="'$(Meziantou_EmbeddedConstantsClassName)' == ''">EmbeddedConstants</Meziantou_EmbeddedConstantsClassName>
    <Meziantou_EmbeddedConstantsClassVisibility Condition="'$(Meziantou_EmbeddedConstantsClassVisibility)' == ''">internal</Meziantou_EmbeddedConstantsClassVisibility>
    <Meziantou_EmbeddedConstantsMemberVisibility Condition="'$(Meziantou_EmbeddedConstantsMemberVisibility)' == ''">public</Meziantou_EmbeddedConstantsMemberVisibility>
    <Meziantou_EmbeddedConstantsOutputPath Condition="'$(Meziantou_EmbeddedConstantsOutputPath)' == ''">$([MSBuild]::NormalizePath('$(IntermediateOutputPath)', 'Meziantou.Framework.EmbeddedConstantsGenerator', 'EmbeddedConstants.g.cs'))</Meziantou_EmbeddedConstantsOutputPath>

    <!-- The inner builds of a multi-targeted project run in parallel, so they must not share one generated
         file. The default path already varies by target framework through IntermediateOutputPath, but a
         path set by the user might not, so the target framework is inserted into it. -->
    <Meziantou_EmbeddedConstantsOutputPath Condition="'$(TargetFrameworks)' != '' and '$(TargetFramework)' != '' and !$(Meziantou_EmbeddedConstantsOutputPath.Contains('$(TargetFramework)'))">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(Meziantou_EmbeddedConstantsOutputPath)')), '$(TargetFramework)', $([System.IO.Path]::GetFileName('$(Meziantou_EmbeddedConstantsOutputPath)'))))</Meziantou_EmbeddedConstantsOutputPath>

    <_EmbeddedConstantsGeneratedCodePath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(Meziantou_EmbeddedConstantsOutputPath)'))</_EmbeddedConstantsGeneratedCodePath>
    <_EmbeddedConstantsGeneratedCodeDirectory>$([System.IO.Path]::GetDirectoryName('$(_EmbeddedConstantsGeneratedCodePath)'))</_EmbeddedConstantsGeneratedCodeDirectory>

    <!-- When the generated files live inside the project directory, the SDK's default glob picks up every
         framework's copy once they exist, which breaks the second build. The target drops them and adds
         back only this framework's file. The pattern is kept relative to match how the default glob
         specifies its items. -->
    <_EmbeddedConstantsGeneratedCodeRelativePath>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '$(_EmbeddedConstantsGeneratedCodePath)'))</_EmbeddedConstantsGeneratedCodeRelativePath>
    <_EmbeddedConstantsGeneratedCodeGlob Condition="'$(TargetFrameworks)' != '' and '$(TargetFramework)' != ''">$(_EmbeddedConstantsGeneratedCodeRelativePath.Replace('$(TargetFramework)', '*'))</_EmbeddedConstantsGeneratedCodeGlob>
    <_EmbeddedConstantsGeneratedCodeGlob Condition="'$(_EmbeddedConstantsGeneratedCodeGlob)' == ''">$(_EmbeddedConstantsGeneratedCodeRelativePath)</_EmbeddedConstantsGeneratedCodeGlob>
  </PropertyGroup>

  <!-- The Visual Studio fast up-to-date check only knows about well-known item types. Without this,
       editing an embedded file does not invalidate the project and the build is skipped entirely. -->
  <ItemGroup>
    <UpToDateCheckInput Include="@(EmbeddedConstant)" />
  </ItemGroup>

  <!-- This file is imported after the SDK's default globs, so removing here drops the generated files they
       picked up; the target below adds this framework's file back. Unescape is required because MSBuild
       escapes wildcards that come from a property, which would make this match nothing. The removal is
       unconditional because an item reference is not allowed in an evaluation-time condition, and the
       pattern only ever matches files this package generates. -->
  <ItemGroup>
    <Compile Remove="$([MSBuild]::Unescape('$(_EmbeddedConstantsGeneratedCodeGlob)'))" />
  </ItemGroup>

  <UsingTask TaskName="Meziantou.Framework.EmbeddedConstantsGenerator.GenerateEmbeddedConstantsTask"
             AssemblyFile="$(_EmbeddedConstantsTaskAssemblyPath)"
             Condition="Exists('$(_EmbeddedConstantsTaskAssemblyPath)')" />

  <Target Name="GenerateEmbeddedConstants"
          BeforeTargets="CoreCompile;BeforeCompile"
          Condition="'@(EmbeddedConstant)' != '' and '$(IsCrossTargetingBuild)' != 'true'">
    <MakeDir Directories="$(_EmbeddedConstantsGeneratedCodeDirectory)" />

    <GenerateEmbeddedConstantsTask EmbeddedConstants="@(EmbeddedConstant)"
                                   OutputPath="$(_EmbeddedConstantsGeneratedCodePath)"
                                   Namespace="$(Meziantou_EmbeddedConstantsNamespace)"
                                   ClassName="$(Meziantou_EmbeddedConstantsClassName)"
                                   ClassVisibility="$(Meziantou_EmbeddedConstantsClassVisibility)"
                                   MemberVisibility="$(Meziantou_EmbeddedConstantsMemberVisibility)"
                                   ProjectDirectory="$(MSBuildProjectDirectory)" />

    <ItemGroup>
      <Compile Include="$(_EmbeddedConstantsGeneratedCodePath)" AutoGen="true" DesignTime="true" Visible="false" />
      <FileWrites Include="$(_EmbeddedConstantsGeneratedCodePath)" />
      <EmbedInBinlog Include="$(_EmbeddedConstantsGeneratedCodePath)" />
    </ItemGroup>
  </Target>

  <Target Name="CleanEmbeddedConstants"
          BeforeTargets="CoreClean"
          Condition="'@(EmbeddedConstant)' != '' and '$(IsCrossTargetingBuild)' != 'true'">
    <Delete Files="$(_EmbeddedConstantsGeneratedCodePath)" />
  </Target>
</Project>
