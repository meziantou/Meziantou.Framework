<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsTrimmable>true</IsTrimmable>
    <Version>1.0.4</Version>
    <Description>Fully managed OpenType font reader and text shaper shared by Meziantou.Framework.Imaging and Meziantou.Framework.WebPlatform: TrueType, CFF and CFF2 outlines, WOFF and WOFF2, variable fonts, color fonts, the shaping of complex scripts, and AFM font metrics files.</Description>
    <PackageTags>font;opentype;truetype;woff;woff2;cff;shaping;typography;afm</PackageTags>

    <!-- Every member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Unicode properties shaping needs (scripts, joining types, Indic categories, normalization) -->
    <ProjectReference Include="..\Meziantou.Framework.Unicode\Meziantou.Framework.Unicode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Adler-32 checksum of the tables of WOFF files -->
    <ProjectReference Include="..\Meziantou.Framework.Hashing\Meziantou.Framework.Hashing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The metrics of the 14 standard fonts of PDF, as Adobe published them in Core14_AFMs.zip (see THIRD-PARTY-NOTICES.md):
      their license forbids distributing the AFM files without MustRead.html
    -->
    <EmbeddedResource Include="Afm\StandardFonts\*.afm;Afm\StandardFonts\MustRead.html" LogicalName="Meziantou.Framework.Fonts.Afm.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests, the fuzzing and the benchmarks also use the internal types -->
    <InternalsVisibleTo Include="Meziantou.Framework.Imaging.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Imaging.FuzzTests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Imaging.Benchmarks" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Fuzz" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Benchmarks" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Imaging.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Pdf.Tests" />
  </ItemGroup>
</Project>
