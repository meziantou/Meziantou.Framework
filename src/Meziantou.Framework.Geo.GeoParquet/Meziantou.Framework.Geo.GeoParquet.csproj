<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Geo</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Reads GeoParquet files (.parquet), the columnar format of geospatial data lakes, as the features of Meziantou.Framework.Geo, one row group at a time, skipping the row groups outside of a region.</Description>
    <PackageTags>geo;gis;geoparquet;parquet;features;wkb</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The fuzz targets call the decoders of the Parquet format directly -->
    <InternalsVisibleTo Include="Meziantou.Framework.Geo.GeoParquet.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Geo/Meziantou.Framework.Geo.csproj" />
  </ItemGroup>

  <!-- The Zstandard decoder of Meziantou.Framework.Imaging, for the targets older than .NET 11 (which has ZstandardStream): the files are compiled here too, in the namespace of the library, so that they stay internal to both -->
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <Compile Include="../Meziantou.Framework.Imaging/Internals/Compression/ZstdDecoder.cs" Link="Internals/Shared/ZstdDecoder.cs" />
    <Compile Include="../Meziantou.Framework.Imaging/Internals/Compression/XxHash64.cs" Link="Internals/Shared/XxHash64.cs" />
  </ItemGroup>

</Project>
