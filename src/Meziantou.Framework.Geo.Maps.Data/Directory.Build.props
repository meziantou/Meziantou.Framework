<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    The packages of the map bundles: a project per region, generated by the update-projects command of
    tools/Meziantou.Framework.Geo.Maps.Tool (see the update-geo-maps-data workflow). Each one embeds the layers of its
    region, which are not committed: update-projects, or the build command of the tool, writes them to the data folder,
    and CI does it before packing. Without them, the projects still compile, but cannot be packed.
  -->
  <PropertyGroup>
    <!-- The projects of the repository must target LatestTargetFramework: the maps target the oldest framework of
         Meziantou.Framework.Geo.Maps, MinimumTargetFramework, set in each project (Meziantou.NET.Sdk picks a target
         framework for the projects whose file sets none) -->
    <ValidateProjectTargets>false</ValidateProjectTargets>
    <RootNamespace>Meziantou.Framework.Geo.Maps.Data</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The borders and subdivisions are derived from OpenStreetMap: the maps are under the ODbL, not the MIT license of the repository -->
    <PackageLicenseExpression>ODbL-1.0</PackageLicenseExpression>
    <PackageTags>geo;gis;map;maps;offline;borders;cities;flatgeobuf;openstreetmap;natural-earth</PackageTags>
    <_PackageReadmeFilePath>$(MSBuildThisFileDirectory)readme.md</_PackageReadmeFilePath>

    <!--
      NU5123: the path of a file in the package folder (id/version/lib/net10.0/<id>.dll) is long for the longest region
      names, such as SouthGeorgiaAndSouthSandwichIslands. It exceeds the limit only with the -build-<commit> suffix CI
      adds to the versions of pull requests; a published version, 1.0.x, is about 45 characters below it
    -->
    <NoWarn>$(NoWarn);NU5123</NoWarn>

    <!-- The layers of the regions: data/<Key>/<layer>.fgb -->
    <MapDataDirectory>$(MSBuildThisFileDirectory)data/</MapDataDirectory>
  </PropertyGroup>

</Project>
