<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Geo.Maps</RootNamespace>
    <Version>1.0.2</Version>
    <Description>Loads offline map bundles: the borders, states and provinces, cities, rivers, lakes, coastlines, land, ocean, seas and physical regions of a region, stored as folders of FlatGeobuf or GeoJSON layers, or in other formats such as GeoPackage.</Description>
    <PackageTags>geo;gis;map;maps;offline;borders;countries;cities;flatgeobuf;geojson;openstreetmap;natural-earth</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Geo/Meziantou.Framework.Geo.csproj" />
  </ItemGroup>

</Project>
