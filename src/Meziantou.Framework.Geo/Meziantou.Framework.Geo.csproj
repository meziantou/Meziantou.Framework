<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Geo</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Geographic features and geometries, geometry operations (repair, clip, simplify, union, intersection, difference), map projections, and readers and writers for GeoJSON, TopoJSON, WKT, WKB, KML, KMZ, GPX, Shapefile and FlatGeobuf, with no dependency outside .NET.</Description>
    <PackageTags>geo;gis;geojson;topojson;wkt;wkb;kml;kmz;gpx;shapefile;flatgeobuf;map;projection;mercator;clip;simplify;make-valid</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Geo.Tests" />
  </ItemGroup>

</Project>
