<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Geo</RootNamespace>
    <Version>1.0.0</Version>
    <IsTrimmable>true</IsTrimmable>
    <Description>Geographic features and geometries, map projections, and readers and writers for GeoJSON, TopoJSON, WKT, WKB, KML, KMZ, GPX and Shapefile, with no dependency outside .NET.</Description>
    <PackageTags>geo;gis;geojson;topojson;wkt;wkb;kml;kmz;gpx;shapefile;map;projection;mercator</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Geo.Tests" />
  </ItemGroup>

</Project>
