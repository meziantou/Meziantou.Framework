<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <!-- Converts internationalized domain names with IdnMapping -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Http</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.1.13</Version>
    <Description>Provide an HTTP message handler that upgrades requests from http to https when an HSTS policy is set for the domain</Description>
    <PackageTags>http, https, hsts, security, httpclient</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Http.Hsts.Tests" />
  </ItemGroup>

  <!-- Read in place, so it is not compressed. See HstsPreloadList.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="preload.bin" LogicalName="preload.bin" />
  </ItemGroup>
</Project>
