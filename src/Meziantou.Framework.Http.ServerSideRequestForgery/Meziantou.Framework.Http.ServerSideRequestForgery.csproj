<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Version>2.0.3</Version>
    <IsTrimmable>true</IsTrimmable>
    <Description>Protects outbound SocketsHttpHandler requests against SSRF by validating schemes and resolved IP addresses.</Description>
    <PackageTags>ssrf, security, http, httpclient, validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Http.ServerSideRequestForgery.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
