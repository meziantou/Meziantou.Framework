<Project>
  <!--
    Each IconifyIconSet item declares an icon set to generate:
      <IconifyIconSet Include="mdi" />                    downloads json/mdi.json from the iconify/icon-sets repository
      <IconifyIconSet Include="mdi" Version="<git ref>" /> downloads the file of a tag, a branch or a commit
      <IconifyIconSet Include="icons/custom.json" />      uses a local file (an Include that ends with .json)
    Optional metadata: ClassName (name of the generated property) and Icons (names to generate, separated by ';', '*' is a wildcard).
  -->
  <PropertyGroup>
    <IconifyIconSetsBaseUrl Condition="'$(IconifyIconSetsBaseUrl)' == ''">https://raw.githubusercontent.com/iconify/icon-sets</IconifyIconSetsBaseUrl>
    <IconifyIconSetsDefaultVersion Condition="'$(IconifyIconSetsDefaultVersion)' == ''">master</IconifyIconSetsDefaultVersion>
    <IconifyCacheDirectory Condition="'$(IconifyCacheDirectory)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'iconify'))</IconifyCacheDirectory>
    <IconifyCacheDirectory>$([MSBuild]::EnsureTrailingSlash('$(IconifyCacheDirectory)'))</IconifyCacheDirectory>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="IconifyVisibility" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="IconifyIconSet" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="IconifyClassName" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="IconifyIcons" />

    <!-- IconifyResolveIconSets builds this file as a project, which is not a ProjectReference (msbuild -isolate) -->
    <GraphIsolationExemptReference Include="$(MSBuildThisFileFullPath)" />
  </ItemGroup>

  <Target Name="IconifyResolveIconSets"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile"
          Condition="'@(IconifyIconSet)' != ''">
    <ItemGroup>
      <_IconifyLocalIconSet Include="@(IconifyIconSet)" Condition="'%(IconifyIconSet.Extension)' == '.json'" />
      <_IconifyRemoteIconSet Include="@(IconifyIconSet)" Exclude="@(_IconifyLocalIconSet)" />
    </ItemGroup>

    <ItemGroup>
      <_IconifyRemoteIconSet>
        <_IconifyVersion Condition="'%(_IconifyRemoteIconSet.Version)' == ''">$(IconifyIconSetsDefaultVersion)</_IconifyVersion>
        <_IconifyVersion Condition="'%(_IconifyRemoteIconSet.Version)' != ''">%(_IconifyRemoteIconSet.Version)</_IconifyVersion>
      </_IconifyRemoteIconSet>
      <_IconifyRemoteIconSet>
        <_IconifyUrl>$(IconifyIconSetsBaseUrl)/%(_IconifyRemoteIconSet._IconifyVersion)/json/%(_IconifyRemoteIconSet.Identity).json</_IconifyUrl>
        <_IconifyDirectory>$(IconifyCacheDirectory)%(_IconifyRemoteIconSet._IconifyVersion)/</_IconifyDirectory>
      </_IconifyRemoteIconSet>
      <_IconifyRemoteIconSet>
        <_IconifyPath>%(_IconifyRemoteIconSet._IconifyDirectory)%(_IconifyRemoteIconSet.Identity).json</_IconifyPath>
      </_IconifyRemoteIconSet>
    </ItemGroup>

    <!-- A cached file is never downloaded again. Pin the Version metadata for reproducible builds.
         The builds of the target frameworks of a project share the cache, and so can several projects (IconifyCacheDirectory).
         So that a build never reads a file that another build is replacing:
         - the MSBuild task downloads the files, by building this file as a project whose global properties are the URL and the
           destination, without TargetFramework and RuntimeIdentifier. MSBuild builds a project with the same global properties
           once per build, and the other requests wait for its result: each file is downloaded once per build;
         - the download goes to a temporary file, moved to the cache once it is complete: an interrupted download is not mistaken
           for a cached file;
         - a cached file is never replaced: when another build, such as another dotnet build process, adds the file first, the
           temporary file is deleted. -->
    <ItemGroup>
      <_IconifyDownloadRequest Include="@(_IconifyRemoteIconSet->'$(MSBuildThisFileFullPath)')"
                               Condition="'%(_IconifyRemoteIconSet.Identity)' != '' AND !Exists('%(_IconifyRemoteIconSet._IconifyPath)')">
        <AdditionalProperties>_IconifyDownloadUrl=%(_IconifyRemoteIconSet._IconifyUrl);_IconifyDownloadDirectory=%(_IconifyRemoteIconSet._IconifyDirectory);_IconifyDownloadFileName=%(_IconifyRemoteIconSet.Identity).json</AdditionalProperties>
      </_IconifyDownloadRequest>
    </ItemGroup>

    <MSBuild Projects="@(_IconifyDownloadRequest)"
             Targets="_IconifyDownloadIconSet"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             BuildInParallel="$(BuildInParallel)"
             Condition="'@(_IconifyDownloadRequest)' != ''" />

    <ItemGroup>
      <AdditionalFiles Include="@(_IconifyLocalIconSet->'%(FullPath)')">
        <IconifyIconSet>true</IconifyIconSet>
        <IconifyClassName>%(_IconifyLocalIconSet.ClassName)</IconifyClassName>
        <IconifyIcons>%(_IconifyLocalIconSet.Icons)</IconifyIcons>
      </AdditionalFiles>
      <AdditionalFiles Include="@(_IconifyRemoteIconSet->'%(_IconifyPath)')">
        <IconifyIconSet>true</IconifyIconSet>
        <IconifyClassName>%(_IconifyRemoteIconSet.ClassName)</IconifyClassName>
        <IconifyIcons>%(_IconifyRemoteIconSet.Icons)</IconifyIcons>
      </AdditionalFiles>
    </ItemGroup>
  </Target>

  <!-- Downloads _IconifyDownloadUrl to _IconifyDownloadDirectory/_IconifyDownloadFileName. IconifyResolveIconSets builds this file as a project to call it. -->
  <Target Name="_IconifyDownloadIconSet">
    <PropertyGroup>
      <_IconifyDownloadPath>$(_IconifyDownloadDirectory)$(_IconifyDownloadFileName)</_IconifyDownloadPath>
      <_IconifyDownloadTemporaryFileName>$(_IconifyDownloadFileName).$([System.Guid]::NewGuid().ToString('N')).download</_IconifyDownloadTemporaryFileName>
      <_IconifyDownloadTemporaryPath>$(_IconifyDownloadDirectory)$(_IconifyDownloadTemporaryFileName)</_IconifyDownloadTemporaryPath>
    </PropertyGroup>

    <!-- Continue on error, so that the temporary file of a failed download is deleted -->
    <DownloadFile SourceUrl="$(_IconifyDownloadUrl)"
                  DestinationFolder="$(_IconifyDownloadDirectory)"
                  DestinationFileName="$(_IconifyDownloadTemporaryFileName)"
                  Retries="3"
                  ContinueOnError="ErrorAndContinue"
                  Condition="!Exists('$(_IconifyDownloadPath)')" />

    <!-- The Move task deletes an existing destination before it moves the file, so it only runs when there is none -->
    <Move SourceFiles="$(_IconifyDownloadTemporaryPath)"
          DestinationFiles="$(_IconifyDownloadPath)"
          Condition="'$(MSBuildLastTaskResult)' == 'true' AND Exists('$(_IconifyDownloadTemporaryPath)') AND !Exists('$(_IconifyDownloadPath)')" />

    <Delete Files="$(_IconifyDownloadTemporaryPath)"
            Condition="Exists('$(_IconifyDownloadTemporaryPath)')" />
  </Target>
</Project>
