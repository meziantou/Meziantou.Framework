<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Imaging.Barcodes</RootNamespace>
    <Version>1.0.8</Version>
    <Description>Renders and draws the QR codes and barcodes of Meziantou.Framework.Barcodes with Meziantou.Framework.Imaging: images in any format, or vector drawing on a canvas; and reads the QR codes, 2D symbols and barcodes of images</Description>
    <PackageTags>qrcode, barcode, image, imaging, drawing, canvas, ocr-a, ocr-b, font, png, webp, jpeg, reader, scanner, decoder</PackageTags>
    <!-- The decoders of Meziantou.Framework.Barcodes take module matrices -->
    <NoWarn>$(NoWarn);CA1814</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/Meziantou.Framework.Imaging.Barcodes.FontGenerator: see its readme -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Meziantou.Framework.Imaging.Barcodes.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Imaging.Barcodes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Barcodes/Meziantou.Framework.Barcodes.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Imaging/Meziantou.Framework.Imaging.csproj" />
  </ItemGroup>

</Project>
