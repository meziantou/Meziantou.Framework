<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Imaging.Charts</RootNamespace>
    <Version>1.0.2</Version>
    <Description>Renders the charts of Meziantou.Framework.Charts with Meziantou.Framework.Imaging: images in any format (PNG, WebP, JPEG...), or vector drawing on a canvas, with embedded Liberation Sans fonts.</Description>
    <PackageTags>chart;charts;plot;image;imaging;png;drawing;canvas;visualization</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Charts/Meziantou.Framework.Charts.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Imaging.VectorGraphics/Meziantou.Framework.Imaging.VectorGraphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Imaging.Charts.Tests" />
  </ItemGroup>

</Project>
