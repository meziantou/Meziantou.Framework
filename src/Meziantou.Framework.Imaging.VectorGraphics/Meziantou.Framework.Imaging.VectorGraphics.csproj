<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Imaging.VectorGraphics</RootNamespace>
    <Version>1.0.2</Version>
    <Description>Draws the scenes of Meziantou.Framework.VectorGraphics (charts, diagrams) with Meziantou.Framework.Imaging: images in any format (PNG, WebP, JPEG...), or vector drawing on a canvas, with embedded Liberation Sans fonts.</Description>
    <PackageTags>svg;vector;graphics;scene;image;imaging;png;drawing;canvas</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Liberation Sans 2.1.5 (SIL Open Font License 1.1, see THIRD-PARTY-NOTICES.md), the subsets Meziantou.Framework.Pdf bundles -->
    <EmbeddedResource Include="../Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationSans-Regular.woff2" Link="Fonts/LiberationSans-Regular.woff2" LogicalName="Meziantou.Framework.Imaging.VectorGraphics.Fonts.LiberationSans-Regular.woff2" />
    <EmbeddedResource Include="../Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationSans-Bold.woff2" Link="Fonts/LiberationSans-Bold.woff2" LogicalName="Meziantou.Framework.Imaging.VectorGraphics.Fonts.LiberationSans-Bold.woff2" />
    <EmbeddedResource Include="../Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationSans-Italic.woff2" Link="Fonts/LiberationSans-Italic.woff2" LogicalName="Meziantou.Framework.Imaging.VectorGraphics.Fonts.LiberationSans-Italic.woff2" />
    <EmbeddedResource Include="../Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationSans-BoldItalic.woff2" Link="Fonts/LiberationSans-BoldItalic.woff2" LogicalName="Meziantou.Framework.Imaging.VectorGraphics.Fonts.LiberationSans-BoldItalic.woff2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.VectorGraphics/Meziantou.Framework.VectorGraphics.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Imaging/Meziantou.Framework.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Places the spans of the texts as the SVG renderer and the other renderers do -->
    <Compile Include="../Meziantou.Framework.VectorGraphics/Internals/TextPlacement.cs" Link="Internal/TextPlacement.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Imaging.VectorGraphics.Tests" />
  </ItemGroup>

</Project>
