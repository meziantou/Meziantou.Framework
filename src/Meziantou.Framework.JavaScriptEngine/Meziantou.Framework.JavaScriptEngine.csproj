<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.JavaScriptEngine</RootNamespace>
    <Description>An ECMAScript engine written in .NET: a parser, a bytecode compiler and an interpreter, validated by test262.</Description>
    <PackageTags>javascript, ecmascript, js, engine, interpreter</PackageTags>
    <Version>1.0.7</Version>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Language.Regex/Meziantou.Framework.Language.Regex.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Unicode/Meziantou.Framework.Unicode.csproj" />
    <!-- The word lists and the dictionary break engines of ICU, used by the word segmentation of Intl.Segmenter -->
    <ProjectReference Include="../Meziantou.Framework.Unicode.Dictionaries/Meziantou.Framework.Unicode.Dictionaries.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.JavaScriptEngine.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.JavaScriptEngine.Test262" />
    <InternalsVisibleTo Include="Meziantou.Framework.JavaScriptEngine.Benchmarks" />
    <InternalsVisibleTo Include="Meziantou.Framework.JavaScriptEngine.Data.Generator" />
  </ItemGroup>
  <ItemGroup>
    <!-- The IANA time zone database, generated by tools/Meziantou.Framework.JavaScriptEngine.Data.Generator -->
    <EmbeddedResource Include="TimeZones/tzdb.bin" LogicalName="Meziantou.Framework.JavaScriptEngine.TimeZones.tzdb.bin" />
    <!-- The CLDR data of Intl, generated by tools/Meziantou.Framework.JavaScriptEngine.Data.Generator -->
    <EmbeddedResource Include="Intl/Data/locales.bin" LogicalName="Meziantou.Framework.JavaScriptEngine.Intl.Data.locales.bin" />
    <EmbeddedResource Include="Intl/Data/supplemental.bin" LogicalName="Meziantou.Framework.JavaScriptEngine.Intl.Data.supplemental.bin" />
    <EmbeddedResource Include="Intl/Data/collation.bin" LogicalName="Meziantou.Framework.JavaScriptEngine.Intl.Data.collation.bin" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Language.Regex/Meziantou.Framework.Language.Regex.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Unicode/Meziantou.Framework.Unicode.csproj" />
  </ItemGroup>
</Project>
