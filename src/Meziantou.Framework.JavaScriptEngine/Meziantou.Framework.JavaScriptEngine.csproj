<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.JavaScriptEngine</RootNamespace>
    <Description>An ECMAScript engine written in .NET: a parser, a bytecode compiler and an interpreter, validated by test262.</Description>
    <PackageTags>javascript, ecmascript, js, engine, interpreter</PackageTags>
    <Version>1.0.0</Version>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
    <!-- TEMPORARY: the syntax tree is used by the parser and the compiler, which are being written. Remove once they exist. -->
    <NoWarn>$(NoWarn);MA0182</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Language.Regex/Meziantou.Framework.Language.Regex.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Unicode/Meziantou.Framework.Unicode.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.JavaScriptEngine.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.JavaScriptEngine.Test262" />
    <InternalsVisibleTo Include="Meziantou.Framework.JavaScriptEngine.Benchmarks" />
  </ItemGroup>
</Project>
