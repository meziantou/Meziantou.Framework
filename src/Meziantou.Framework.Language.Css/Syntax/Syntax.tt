        Node("CssImportLayerSyntax", "CssSyntaxNode", "ImportLayer", "ImportLayer", "t:LayerToken", "n?:Name:CssLayerNameSyntax", "t?:CloseParenToken"),
        Node("CssImportSupportsSyntax", "CssSyntaxNode", "ImportSupports", "ImportSupports", "t:FunctionToken", "n:Condition:CssConditionSyntax", "t:CloseParenToken"),
        Node("CssNamespacePreludeSyntax", "CssPreludeSyntax", "NamespacePrelude", "NamespacePrelude", "t?:PrefixToken", "n:Url:CssComponentValueSyntax"),
        Node("CssLayerNameSyntax", "CssSyntaxNode", "LayerName", "LayerName", "tl:Tokens"),
        Node("CssLayerPreludeSyntax", "CssPreludeSyntax", "LayerPrelude", "LayerPrelude", "s:Names:CssLayerNameSyntax:CommaToken"),
        Node("CssScopePreludeSyntax", "CssPreludeSyntax", "ScopePrelude", "ScopePrelude", "n?:Start:CssScopeBoundarySyntax", "t?:ToKeyword", "n?:End:CssScopeBoundarySyntax"),
        Node("CssScopeBoundarySyntax", "CssSyntaxNode", "ScopeBoundary", "ScopeBoundary", "t:OpenParenToken", "n?:Selectors:CssSelectorListSyntax", "t:CloseParenToken"),
        Node("CssKeyframeSelectorListSyntax", "CssPreludeSyntax", "KeyframeSelectorList", "KeyframeSelectorList", "s:Selectors:CssKeyframeSelectorSyntax:CommaToken"),
        Node("CssKeyframeSelectorSyntax", "CssSyntaxNode", "KeyframeSelector", "KeyframeSelector", "t?:RangeNameToken", "t:OffsetToken"),
