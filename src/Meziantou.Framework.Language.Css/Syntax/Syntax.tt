        Node("CssClassSelectorSyntax", "CssSimpleSelectorSyntax", "ClassSelector", "ClassSelector", "t:DotToken", "t:NameToken"),
        Node("CssAttributeSelectorSyntax", "CssSimpleSelectorSyntax", "AttributeSelector", "AttributeSelector", "t:OpenBracketToken", "n?:NamespacePrefix:CssNamespacePrefixSyntax", "t:NameToken", "t?:OperatorPrefixToken", "t?:EqualsToken", "t?:ValueToken", "t?:ModifierToken", "t:CloseBracketToken"),
