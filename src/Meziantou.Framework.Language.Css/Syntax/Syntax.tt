    // The shape of every CSS node.
    //
    // A slot is written "<kind>:<Name>[:<Type>]", where the kind is one of:
    //   t   a token            t?  a token the source may not have
    //   n   a child node       n?  a child node the source may not have
    //   l   a list of nodes    s   a list of nodes with separators between them
    //
    // An "s" slot may name the separator its list holds, as "s:Name:Type:SeparatorKind". Naming it is what lets a
    // node be added to a list that has none yet -- a selector list of one selector has no comma to copy.
    //   tl  a list of tokens
    //
    // Node(name, base, kind, visit, slots...) fixes a node's kind; MultiKind(name, base, visit, slots...) is for the
    // handful of classes that serve several kinds and take theirs from the parser.
    //
    // Only the structure is described here. Everything a node computes from its own parts -- a name, a value, which
    // of its children are arguments -- stays in the hand-written half of the partial class.
    var nodes = new[]
    {
        // The generic layer of CSS Syntax Level 3: rules, declarations, and component values.
        Node("CssStyleSheetSyntax", "CssSyntaxNode", "StyleSheet", "StyleSheet", "l:Statements:CssStatementSyntax", "t:EndOfFileToken"),
        MultiKind("CssQualifiedRuleSyntax", "CssRuleSyntax", "QualifiedRule", "n?:Prelude:CssPreludeSyntax", "n:Block:CssBlockSyntax"),
        MultiKind("CssAtRuleSyntax", "CssRuleSyntax", "AtRule", "t:AtKeywordToken", "n?:Prelude:CssPreludeSyntax", "n?:Block:CssBlockSyntax", "t?:SemicolonToken"),
        Node("CssBlockSyntax", "CssSyntaxNode", "Block", "Block", "t:OpenBraceToken", "l:Statements:CssStatementSyntax", "t:CloseBraceToken"),
        Node("CssDeclarationSyntax", "CssStatementSyntax", "Declaration", "Declaration", "t:NameToken", "t:ColonToken", "l:Values:CssComponentValueSyntax", "n?:Important:CssImportantSyntax", "t?:SemicolonToken"),
        Node("CssImportantSyntax", "CssSyntaxNode", "Important", "Important", "t:ExclamationToken", "t:ImportantKeyword"),
        Node("CssBadDeclarationSyntax", "CssStatementSyntax", "BadDeclaration", "BadDeclaration", "l:Values:CssComponentValueSyntax", "t?:SemicolonToken"),
        Node("CssIgnoredTokenSyntax", "CssStatementSyntax", "IgnoredToken", "IgnoredToken", "t:Token"),
        Node("CssSkippedTextSyntax", "CssStatementSyntax", "SkippedText", "SkippedText", "tl:Tokens"),
        Node("CssTokenValueSyntax", "CssComponentValueSyntax", "TokenValue", "TokenValue", "t:Token"),
        Node("CssFunctionSyntax", "CssComponentValueSyntax", "Function", "Function", "t:FunctionToken", "l:Arguments:CssComponentValueSyntax", "t:CloseParenToken"),
        MultiKind("CssSimpleBlockSyntax", "CssComponentValueSyntax", "SimpleBlock", "t:OpenToken", "l:Values:CssComponentValueSyntax", "t:CloseToken"),
        Node("CssSkippedValueSyntax", "CssComponentValueSyntax", "SkippedValue", "SkippedValue", "tl:Tokens"),
        Node("CssGenericPreludeSyntax", "CssPreludeSyntax", "GenericPrelude", "GenericPrelude", "l:Values:CssComponentValueSyntax"),

        // Selectors Level 4 and CSS Nesting.
        Node("CssSelectorListSyntax", "CssPreludeSyntax", "SelectorList", "SelectorList", "s:Selectors:CssSelectorSyntax:CommaToken"),
        Node("CssComplexSelectorSyntax", "CssSelectorSyntax", "ComplexSelector", "ComplexSelector", "l:Parts:CssComplexSelectorPartSyntax"),
        Node("CssComplexSelectorPartSyntax", "CssSyntaxNode", "ComplexSelectorPart", "ComplexSelectorPart", "n?:Combinator:CssCombinatorSyntax", "n:Compound:CssCompoundSelectorSyntax"),
        MultiKind("CssCombinatorSyntax", "CssSyntaxNode", "Combinator", "t:Token", "t?:SecondToken"),
        Node("CssCompoundSelectorSyntax", "CssSyntaxNode", "CompoundSelector", "CompoundSelector", "l:Selectors:CssSimpleSelectorSyntax"),
        Node("CssInvalidSelectorSyntax", "CssSelectorSyntax", "InvalidSelector", "InvalidSelector", "l:Values:CssComponentValueSyntax"),
        Node("CssNamespacePrefixSyntax", "CssSyntaxNode", "NamespacePrefix", "NamespacePrefix", "t?:PrefixToken", "t:BarToken"),
        Node("CssTypeSelectorSyntax", "CssSimpleSelectorSyntax", "TypeSelector", "TypeSelector", "n?:NamespacePrefix:CssNamespacePrefixSyntax", "t:NameToken"),
        Node("CssUniversalSelectorSyntax", "CssSimpleSelectorSyntax", "UniversalSelector", "UniversalSelector", "n?:NamespacePrefix:CssNamespacePrefixSyntax", "t:AsteriskToken"),
        Node("CssNestingSelectorSyntax", "CssSimpleSelectorSyntax", "NestingSelector", "NestingSelector", "t:AmpersandToken"),
