        Node("CssPageSelectorSyntax", "CssSyntaxNode", "PageSelector", "PageSelector", "t?:NameToken", "l:PseudoPages:CssPseudoPageSyntax"),
        Node("CssPseudoPageSyntax", "CssSyntaxNode", "PseudoPage", "PseudoPage", "t:ColonToken", "t:NameToken"),
