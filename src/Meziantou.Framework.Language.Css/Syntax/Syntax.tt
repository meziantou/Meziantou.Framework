        Node("CssMediaQueryListSyntax", "CssPreludeSyntax", "MediaQueryList", "MediaQueryList", "s:Queries:CssMediaQuerySyntax:CommaToken"),
        Node("CssMediaTypeQuerySyntax", "CssMediaQuerySyntax", "MediaTypeQuery", "MediaTypeQuery", "t?:ModifierKeyword", "t:MediaTypeToken", "t?:AndKeyword", "n?:Condition:CssConditionSyntax"),
        Node("CssMediaConditionQuerySyntax", "CssMediaQuerySyntax", "MediaConditionQuery", "MediaConditionQuery", "n:Condition:CssConditionSyntax"),
        Node("CssInvalidMediaQuerySyntax", "CssMediaQuerySyntax", "InvalidMediaQuery", "InvalidMediaQuery", "l:Values:CssComponentValueSyntax"),
