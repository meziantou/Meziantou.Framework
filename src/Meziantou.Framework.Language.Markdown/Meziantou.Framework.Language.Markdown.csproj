<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Language.Markdown</RootNamespace>
    <Description>A prototype of a Roslyn-style immutable CommonMark syntax tree that keeps every character of the text it was parsed from.</Description>
    <PackageTags>markdown, commonmark, syntax-tree, cst, parser</PackageTags>
    <Version>0.1.0</Version>

    <!-- A prototype: it is not published until it parses CommonMark and has an editing API -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Language.Markdown.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Language/Meziantou.Framework.Language.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The attributes that generic attributes write by default, as in Meziantou.Framework.Markdown -->
    <Compile Include="../Meziantou.Framework.HtmlSanitizer/DescriptiveHtmlAttributes.cs" Link="Parsing/DescriptiveHtmlAttributes.cs" />
  </ItemGroup>

</Project>
