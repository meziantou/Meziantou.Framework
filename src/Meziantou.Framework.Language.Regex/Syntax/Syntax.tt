static string FactoryName(NodeDef node) => node.Kind;

static string RewriteArguments(NodeDef node)
{
    var parts = new List<string>();
    foreach (var slot in node.Slots)
    {
        parts.Add(slot.Kind switch
        {
            "t" or "t?" => "VisitToken(node." + slot.Name + ")",
            "tl" => "VisitList(node." + slot.Name + ")",
            "l" or "s" => "VisitList(node." + slot.Name + ")",
            "n" => "(" + slot.Type + "?)Visit(node." + slot.Name + ") ?? node." + slot.Name,
            _ => "(" + slot.Type + "?)Visit(node." + slot.Name + ")",
        });
    }

    return string.Join(", ", parts);
}

static string FactoryParameters(NodeDef node)
{
    var parts = new List<string>();
    foreach (var slot in node.Slots)
    {
        parts.Add(RedSlotType(slot) + " " + Camel(slot.Name));
    }

    parts.Add("RegexPatternOptions options");
    if (node.Base == "RegexGroupSyntax")
    {
        parts.Add("RegexPatternOptions innerOptions");
    }

    foreach (var extra in node.Extra)
    {
        parts.Add(extra);
    }

    return string.Join(", ", parts);
}

static string FactoryArguments(NodeDef node)
{
    var parts = new List<string>();
    foreach (var slot in node.Slots)
    {
        var name = Camel(slot.Name);
        parts.Add(slot.Kind switch
        {
            "t" => "SyntaxFactory.Required(" + name + ")",
            "t?" => name + ".Node",
            "tl" => name + ".Node",
            "l" or "s" => name + ".Green",
            "n" => name + ".Green",
            _ => name + "?.Green",
        });
    }

    parts.Add("options");
    if (node.Base == "RegexGroupSyntax")
    {
        parts.Add("innerOptions");
    }

    foreach (var extra in node.Extra)
    {
        parts.Add(ExtraName(extra));
    }

    return string.Join(", ", parts);
}
