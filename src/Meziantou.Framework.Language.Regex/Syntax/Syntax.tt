        Node("RegexCharacterClassEscapeSyntax", "RegexAtomSyntax", "CharacterClassEscape", "t:EscapeToken"),
        Node("RegexCharacterClassSyntax", "RegexAtomSyntax", "CharacterClass", "t:OpenBracketToken", "t?:CaretToken", "l:Members:RegexSyntaxNode", "t:CloseBracketToken"),
        Node("RegexCharacterEscapeSyntax", "RegexAtomSyntax", "CharacterEscape", "t:EscapeToken"),
