<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Language</RootNamespace>
    <Description>The syntax tree Meziantou.Framework.Language.* is built on: immutable green nodes, the nodes and tokens projected from them, source text, spans, locations, and diagnostics.</Description>
    <PackageTags>syntax-tree, cst, parser, diagnostics, source-text</PackageTags>
    <Version>1.1.0</Version>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Language.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Language.Json" />
    <InternalsVisibleTo Include="Meziantou.Framework.Language.Regex" />
    <InternalsVisibleTo Include="Meziantou.Framework.Language.Shell" />
    <InternalsVisibleTo Include="Meziantou.Framework.Language.Xml" />
  </ItemGroup>

</Project>
