<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Markdown</RootNamespace>
    <Description>A CommonMark and GitHub Flavored Markdown parser for .NET, with the extensions of Markdig, an HTML renderer and a formatter. Its immutable syntax tree keeps every character of the text it was parsed from.</Description>
    <PackageTags>markdown, commonmark, gfm, md, html, md2html, parser, syntax-tree</PackageTags>
    <Version>2.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Markdown.Fuzz" />
    <InternalsVisibleTo Include="Meziantou.Framework.Markdown.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Language/Meziantou.Framework.Language.csproj" />
    <!-- The syntax tree the Markdown nodes are built on -->
    <Using Include="Meziantou.Framework.Language" />
  </ItemGroup>

  <ItemGroup>
    <!-- The attributes that generic attributes write by default, as in Meziantou.Framework.Markdown 1.x -->
    <Compile Include="../Meziantou.Framework.HtmlSanitizer/DescriptiveHtmlAttributes.cs" Link="Parsing/DescriptiveHtmlAttributes.cs" />
  </ItemGroup>

</Project>
