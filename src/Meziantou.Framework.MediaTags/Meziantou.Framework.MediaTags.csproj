<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Version>2.1.6</Version>
    <Description>A library for reading and writing metadata tags in media files (MP3, OGG, FLAC, MP4/M4A/M4V/MOV, WAV, AIFF, APE, WavPack, Musepack, WMA/WMV)</Description>
    <PackageTags>metadata, tags, id3, mp3, flac, ogg, mp4, ape, wavpack, musepack, wma, asf</PackageTags>
  </PropertyGroup>

</Project>
