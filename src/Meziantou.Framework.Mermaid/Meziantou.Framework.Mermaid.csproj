<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Mermaid</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Reads and writes the Mermaid text format: the 25 diagram types of Meziantou.Framework.Diagrams, and the pie, XY, quadrant, sankey and radar charts and treemaps of Mermaid drawn with Meziantou.Framework.Charts, with the front matter, the directives and the themes of Mermaid.</Description>
    <PackageTags>mermaid;mermaid-js;diagram;diagrams;chart;charts;svg;flowchart;uml;pie-chart;sankey;treemap;parser;markdown</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Charts/Meziantou.Framework.Charts.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Diagrams/Meziantou.Framework.Diagrams.csproj" />
    <ProjectReference Include="../Meziantou.Framework.Yaml/Meziantou.Framework.Yaml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Meziantou.Framework.Diagrams" />
    <Using Include="Meziantou.Framework.VectorGraphics" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Mermaid.Tests" />
  </ItemGroup>

</Project>
