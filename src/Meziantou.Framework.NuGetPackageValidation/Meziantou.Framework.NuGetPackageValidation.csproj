<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Version>2.0.11</Version>
    <Description>Provide rules to validate a NuGet package follows best practices</Description>
    <PackageTags>nuget, package, validation, best-practices</PackageTags>
    <IncludeSharedHttpClient>true</IncludeSharedHttpClient>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.FullPath/Meziantou.Framework.FullPath.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
  </ItemGroup>

</Project>
