<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Pdf.JavaScript</RootNamespace>
    <Version>1.0.3</Version>
    <Description>Runs the scripts of the interactive forms of Meziantou.Framework.Pdf in a sandbox of Meziantou.Framework.JavaScriptEngine: keystroke, validation, calculation and format scripts, the AF functions of the viewers and util.printf/printd/scand, with limits of time, statements and memory.</Description>
    <PackageTags>pdf;acroform;form;javascript;calculation;sandbox</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Pdf/Meziantou.Framework.Pdf.csproj" />
    <ProjectReference Include="../Meziantou.Framework.JavaScriptEngine/Meziantou.Framework.JavaScriptEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The functions of the viewers (AF functions, util) and the objects of the form the scripts see -->
    <EmbeddedResource Include="Prelude.js" LogicalName="Meziantou.Framework.Pdf.JavaScript.Prelude.js" Compression="Deflate" />
    <EmbeddedResource Include="FormApi.js" LogicalName="Meziantou.Framework.Pdf.JavaScript.FormApi.js" Compression="Deflate" />
    <Compile Include="../../common/CompressedResource.cs" Link="Utils/CompressedResource.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Pdf.JavaScript.Tests" />
  </ItemGroup>

</Project>
