<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Meziantou.Framework.Pdf.Signing</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Digital signatures of PDF documents: PAdES baseline B-B and B-T signing (CAdES detached signatures, RFC 3161 time stamps) and the verification of the signatures of a document.</Description>
    <PackageTags>pdf;signature;digital-signature;pades;cades;cms;timestamp</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The objects, the writer and the dates of PDF (internal types, through InternalsVisibleTo) -->
    <ProjectReference Include="..\Meziantou.Framework.Pdf\Meziantou.Framework.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CMS signed data of the signatures and the RFC 3161 time stamps -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Pdf.Signing.Tests" />
  </ItemGroup>

  <!-- The library is released together with the library whose internal types it uses: it depends on its exact version -->
  <Target Name="UseExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReferencesWithVersions Include="@(_ProjectReferencesWithVersions)" Condition="'%(Filename)' == 'Meziantou.Framework.Pdf'" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
      <_ProjectReferencesWithVersions Remove="@(_ExactProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferencesWithVersions)" />
    </ItemGroup>
  </Target>
</Project>
