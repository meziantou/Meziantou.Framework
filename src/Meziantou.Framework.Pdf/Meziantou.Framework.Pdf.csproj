<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Meziantou.Framework.Pdf</RootNamespace>
    <Version>1.0.4</Version>
    <Description>Fully managed PDF library for .NET, written from ISO 32000-2: an object model, a reader that recovers broken files (cross-reference tables and streams, object streams, incremental updates), the standard filters (CCITT and JBIG2 included), full and incremental writers, a document API (pages, content builder, standard 14 fonts and embedded font subsets, shadings, patterns, forms and transparency, images, metadata, outlines, links, text extraction), a renderer of the pages to images, and PAdES digital signatures and their verification.</Description>
    <PackageTags>pdf;pdf-reader;pdf-writer;pdf-renderer;document;iso-32000;font-embedding;rasterizer;signature;pades</PackageTags>

    <!-- Every public member must be documented -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>

    <!-- The decoders compiled from the sources of Meziantou.Framework.Imaging are in the namespace of this library -->
    <DefineConstants>$(DefineConstants);MEZIANTOU_FRAMEWORK_PDF</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The image codecs (DCTDecode, JPXDecode, the images of the documents), the ICC profiles, and the canvas the renderer draws the pages on -->
    <ProjectReference Include="..\Meziantou.Framework.Imaging\Meziantou.Framework.Imaging.csproj" />
    <!-- The fonts: their tables, the shaping of the text, the subsetter, the AFM metrics of the standard fonts, the outlines the renderer draws and the system fonts -->
    <ProjectReference Include="..\Meziantou.Framework.Fonts\Meziantou.Framework.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CMS signed data of the signatures and the RFC 3161 time stamps (Signing) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The CCITT decoder of TIFF (CCITTFaxDecode, the MMR regions of JBIG2) and the MQ decoder of JPEG 2000 (the arithmetic
      decoding of JBIG2), compiled in the namespace of this library: it uses the public API of Meziantou.Framework.Imaging
      and Meziantou.Framework.Fonts only, so it does not depend on their exact versions
    -->
    <Compile Include="..\Meziantou.Framework.Imaging\Internals\Codecs\Tiff\TiffBitReader.cs" Link="Filters\Shared\TiffBitReader.cs" />
    <Compile Include="..\Meziantou.Framework.Imaging\Internals\Codecs\Tiff\TiffCcittCode.cs" Link="Filters\Shared\TiffCcittCode.cs" />
    <Compile Include="..\Meziantou.Framework.Imaging\Internals\Codecs\Tiff\TiffCcittCodes.cs" Link="Filters\Shared\TiffCcittCodes.cs" />
    <Compile Include="..\Meziantou.Framework.Imaging\Internals\Codecs\Tiff\TiffCcittDecoder.cs" Link="Filters\Shared\TiffCcittDecoder.cs" />
    <Compile Include="..\Meziantou.Framework.Imaging\Internals\Codecs\Jpeg2000\Jpeg2000MqDecoder.cs" Link="Filters\Shared\Jpeg2000MqDecoder.cs" />
    <Compile Include="..\Meziantou.Framework.Imaging\Internals\Codecs\Jpeg2000\Jpeg2000MqTables.cs" Link="Filters\Shared\Jpeg2000MqTables.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Adobe Glyph List and the list of ITC Zapf Dingbats (BSD-3-Clause, see Fonts/GlyphList/LICENSE.md) -->
    <EmbeddedResource Include="Fonts\GlyphList\*.txt" LogicalName="Meziantou.Framework.Pdf.GlyphList.%(Filename).txt" />
    <!-- The fonts that replace the standard fonts in the renderer: Liberation, subset by eng/pdf/update-substitution-fonts.cs -->
    <EmbeddedResource Include="Rendering\Fonts\Substitution\*.woff2" LogicalName="Meziantou.Framework.Pdf.Rendering.Fonts.%(Filename).woff2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Pdf.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Pdf.FuzzTests" />
  </ItemGroup>

</Project>
