      <_MeziantouFrameworkRoslynConstant Include="CSHARP9_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.2.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="CSHARP10_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.4.0'))" />
