      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.2.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_3_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.3.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_3_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.3.1'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_4_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.4.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_5_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.5.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_6_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.6.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_7_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.7.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_8_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.8.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_9_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.9.2'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_10_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.10.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_11_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.11.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_12_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.12.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_13_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.13.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_14_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.14.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_5_0_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '5.0.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_5_3_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '5.3.0'))" />
