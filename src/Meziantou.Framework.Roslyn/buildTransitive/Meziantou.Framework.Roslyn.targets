      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_0_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.0.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.1.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.2.0'))" />
