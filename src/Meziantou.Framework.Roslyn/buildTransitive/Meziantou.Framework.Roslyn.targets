<Project>
  <PropertyGroup>
    <MeziantouFrameworkRoslynDefineConstants Condition="'$(MeziantouFrameworkRoslynDefineConstants)' == ''">true</MeziantouFrameworkRoslynDefineConstants>
  </PropertyGroup>

  <Target Name="_MeziantouFrameworkRoslynDefineConstants"
          BeforeTargets="CoreCompile"
          Condition="'$(MeziantouFrameworkRoslynDefineConstants)' == 'true'">
    <ItemGroup>
      <_MeziantouFrameworkRoslynPackageReferenceCSharp Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.CSharp' and '%(PackageReference.Version)' != ''" />
      <_MeziantouFrameworkRoslynPackageReferenceCommon Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.Common' and '%(PackageReference.Version)' != ''" />
      <_MeziantouFrameworkRoslynPackageReferenceWorkspacesCommon Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.Workspaces.Common' and '%(PackageReference.Version)' != ''" />
      <_MeziantouFrameworkRoslynPackageReferenceCSharpWorkspaces Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.CSharp.Workspaces' and '%(PackageReference.Version)' != ''" />
      <_MeziantouFrameworkRoslynPackageVersionCSharp Include="@(PackageVersion)" Condition="'%(PackageVersion.Identity)' == 'Microsoft.CodeAnalysis.CSharp' and '%(PackageVersion.Version)' != ''" />
      <_MeziantouFrameworkRoslynPackageVersionCommon Include="@(PackageVersion)" Condition="'%(PackageVersion.Identity)' == 'Microsoft.CodeAnalysis.Common' and '%(PackageVersion.Version)' != ''" />
      <_MeziantouFrameworkRoslynPackageVersionWorkspacesCommon Include="@(PackageVersion)" Condition="'%(PackageVersion.Identity)' == 'Microsoft.CodeAnalysis.Workspaces.Common' and '%(PackageVersion.Version)' != ''" />
      <_MeziantouFrameworkRoslynPackageVersionCSharpWorkspaces Include="@(PackageVersion)" Condition="'%(PackageVersion.Identity)' == 'Microsoft.CodeAnalysis.CSharp.Workspaces' and '%(PackageVersion.Version)' != ''" />
      <_MeziantouFrameworkRoslynWorkspacesReference Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.Workspaces.Common' or '%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.CSharp.Workspaces' or '%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.VisualBasic.Workspaces' or '%(PackageReference.Identity)' == 'Microsoft.CodeAnalysis.Workspaces.MSBuild'" />
    </ItemGroup>

    <PropertyGroup>
      <_MeziantouFrameworkRoslynVersion>@(_MeziantouFrameworkRoslynPackageReferenceCSharp->'%(Version)')</_MeziantouFrameworkRoslynVersion>
      <_MeziantouFrameworkRoslynVersion Condition="'$(_MeziantouFrameworkRoslynVersion)' == ''">@(_MeziantouFrameworkRoslynPackageReferenceCommon->'%(Version)')</_MeziantouFrameworkRoslynVersion>
      <_MeziantouFrameworkRoslynVersion Condition="'$(_MeziantouFrameworkRoslynVersion)' == ''">@(_MeziantouFrameworkRoslynPackageReferenceWorkspacesCommon->'%(Version)')</_MeziantouFrameworkRoslynVersion>
      <_MeziantouFrameworkRoslynVersion Condition="'$(_MeziantouFrameworkRoslynVersion)' == ''">@(_MeziantouFrameworkRoslynPackageReferenceCSharpWorkspaces->'%(Version)')</_MeziantouFrameworkRoslynVersion>
      <_MeziantouFrameworkRoslynVersion Condition="'$(_MeziantouFrameworkRoslynVersion)' == ''">@(_MeziantouFrameworkRoslynPackageVersionCSharp->'%(Version)')</_MeziantouFrameworkRoslynVersion>
      <_MeziantouFrameworkRoslynVersion Condition="'$(_MeziantouFrameworkRoslynVersion)' == ''">@(_MeziantouFrameworkRoslynPackageVersionCommon->'%(Version)')</_MeziantouFrameworkRoslynVersion>
      <_MeziantouFrameworkRoslynVersion Condition="'$(_MeziantouFrameworkRoslynVersion)' == ''">@(_MeziantouFrameworkRoslynPackageVersionWorkspacesCommon->'%(Version)')</_MeziantouFrameworkRoslynVersion>
      <_MeziantouFrameworkRoslynVersion Condition="'$(_MeziantouFrameworkRoslynVersion)' == ''">@(_MeziantouFrameworkRoslynPackageVersionCSharpWorkspaces->'%(Version)')</_MeziantouFrameworkRoslynVersion>
    </PropertyGroup>

    <ItemGroup Condition="'$(_MeziantouFrameworkRoslynVersion)' != ''">
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_0_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.0.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_0_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.0.1'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.1.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_1_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.1.1'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.2.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_2_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.2.1'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_2_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.2.2'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_1_3_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '1.3.0'))" />
