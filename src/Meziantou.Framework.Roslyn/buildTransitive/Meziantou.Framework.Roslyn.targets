      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_8_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.8.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_8_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.8.2'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_9_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.9.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_10_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.10.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_0_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.0.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.1.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.2.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_2_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.2.1'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_3_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.3.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_3_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.3.1'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_4_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.4.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_5_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.5.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_6_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.6.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_7_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.7.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_8_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.8.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_9_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.9.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_10_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.10.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_3_11_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '3.11.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_0_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.0.0'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_4_0_1_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '4.0.1'))" />
