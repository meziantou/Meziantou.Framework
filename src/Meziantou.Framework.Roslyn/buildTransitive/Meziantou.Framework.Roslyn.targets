      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_3_2_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.3.2'))" />
      <_MeziantouFrameworkRoslynConstant Include="ROSLYN_2_4_OR_GREATER" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_MeziantouFrameworkRoslynVersion)', '2.4.0'))" />
