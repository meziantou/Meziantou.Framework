<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Description>Represent sensitive data which should be difficult to accidentally disclose, even accounting for some types of application bugs.</Description>
    <PackageTags>security, sensitive-data, secrets, memory, protection</PackageTags>
    <Version>2.0.15</Version>
    <RootNamespace>Meziantou.Framework</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.SensitiveData.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../common/Win32/Windows.Win32.Foundation.BOOL.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.Foundation.HANDLE.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.CryptProtectMemory.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.CryptUnprotectMemory.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.GetProcessHeap.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.HeapAlloc.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.HeapCreate.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.HeapFree.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.System.Memory.HEAP_FLAGS.g.cs" LinkBase="Win32" />
  </ItemGroup>

</Project>
