<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <Description>Enables verification of SixLabors.ImageSharp images using file-based snapshots</Description>
    <Version>2.0.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Meziantou.Framework.SnapshotTesting/Images/SsimAccumulator.cs" Link="Images/SsimAccumulator.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.SnapshotTesting/Meziantou.Framework.SnapshotTesting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.0" />
  </ItemGroup>

</Project>
