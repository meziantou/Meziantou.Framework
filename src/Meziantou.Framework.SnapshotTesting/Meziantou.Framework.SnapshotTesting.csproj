<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsBrowserCompatible>false</IsBrowserCompatible>
    <IsTrimmable>false</IsTrimmable>
    <Description>Enables verification of objects using file-based snapshots</Description>
    <PackageTags>snapshot-testing, approval-tests, testing, assertions</PackageTags>
    <Version>3.1.23</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Meziantou.Framework.HumanReadableSerializer/Utils/StringUtils.cs" Link="Utils/StringUtils.cs" />
    <Compile Include="../Meziantou.Framework/ExecutableFinder.cs" Link="Utils/ExecutableFinder.cs" />
    <Compile Include="../Meziantou.Framework.CommandLine/CommandLineBuilder.cs" Link="Utils/CommandLineBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive" />
    <None Include="buildMultiTargeting/**" Pack="true" PackagePath="buildMultiTargeting" />
    <None Include="common/Meziantou.Framework.SourceRootRegistration.targets" Pack="true" PackagePath="buildTransitive/Meziantou.Framework.SourceRootRegistration.targets" />
    <None Include="common/Meziantou.Framework.SourceRootRegistration.targets" Pack="true" PackagePath="buildMultiTargeting/Meziantou.Framework.SourceRootRegistration.targets" />
    <None Include="common/Meziantou.Framework.SnapshotFiles.targets" Pack="true" PackagePath="buildTransitive/Meziantou.Framework.SnapshotFiles.targets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.SnapshotTesting.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.SnapshotTesting.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.DiffEngine/Meziantou.Framework.DiffEngine.csproj" />
    <ProjectReference Include="../Meziantou.Framework.FullPath/Meziantou.Framework.FullPath.csproj" />
    <ProjectReference Include="../Meziantou.Framework.HumanReadableSerializer/Meziantou.Framework.HumanReadableSerializer.csproj" />
    <ProjectReference Include="../Meziantou.Framework.LLMContext/Meziantou.Framework.LLMContext.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../common/Win32/Windows.Win32.Foundation.BOOL.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.Foundation.HANDLE.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.InlineArrayIndexerExtensions.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.CreateToolhelp32Snapshot.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.CreateToolhelp32Snapshot_SafeHandle.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.GetCurrentProcess.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.Process32FirstW.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.Process32NextW.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.System.Diagnostics.ToolHelp.CREATE_TOOLHELP_SNAPSHOT_FLAGS.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.System.Diagnostics.ToolHelp.PROCESSENTRY32W.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__byte_128.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__byte_14.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__byte_16.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__byte_18.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__byte_20.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__byte_38.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__char_14.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__char_256.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__char_260.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__char_64.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.__ushort_3.g.cs" LinkBase="Win32" />
  </ItemGroup>

</Project>
