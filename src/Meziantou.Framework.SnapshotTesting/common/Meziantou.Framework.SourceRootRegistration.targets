<Project>
  <!--
    This file is packed in both SnapshotTesting and InlineSnapshotTesting, so a project referencing both packages imports
    it twice. The package targets files only import it when this property is not set yet.
    Each package declares a _MeziantouSourceRootRegistration item describing the file to generate, so the core target
    generates one file per referenced package, even though MSBuild runs it only once per project.
  -->
  <PropertyGroup>
    <_MeziantouSourceRootRegistrationTargetsImported>true</_MeziantouSourceRootRegistrationTargetsImported>
  </PropertyGroup>

  <Target Name="_MeziantouGenerateSourceRootFiles"
          DependsOnTargets="InitializeSourceRootMappedPaths"
          Condition="'$(Language)' == 'C#' and '$(DeterministicSourcePaths)' == 'true' and '@(_MeziantouSourceRootRegistration)' != ''"
          Outputs="%(_MeziantouSourceRootRegistration.Identity)">

    <PropertyGroup>
      <_MeziantouSourceRootGeneratedFileName>@(_MeziantouSourceRootRegistration->'%(GeneratedFileName)')</_MeziantouSourceRootGeneratedFileName>
      <_MeziantouSourceRootRegistrationMethod>@(_MeziantouSourceRootRegistration->'%(RegistrationMethod)')</_MeziantouSourceRootRegistrationMethod>
      <_MeziantouSourceRootAssemblyMetadataName>@(_MeziantouSourceRootRegistration->'%(AssemblyMetadataName)')</_MeziantouSourceRootAssemblyMetadataName>
      <_MeziantouSourceRootInitializerClassName>@(_MeziantouSourceRootRegistration->'%(InitializerClassName)')</_MeziantouSourceRootInitializerClassName>
      <!-- Like the SDK generated files, the path is not made absolute: the compiler rejects paths containing a double quote -->
      <_MeziantouSourceRootFile>$(IntermediateOutputPath)$(_MeziantouSourceRootGeneratedFileName)</_MeziantouSourceRootFile>
      <_MeziantouSourceRootNamespaceHash>$([MSBuild]::StableStringHash('$(MSBuildProjectFullPath)|$(_MeziantouSourceRootGeneratedFileName)|$(_MeziantouSourceRootAssemblyMetadataName)|$(_MeziantouSourceRootInitializerClassName)', 'SHA256'))</_MeziantouSourceRootNamespaceHash>
      <_MeziantouSourceRootNamespace>Meziantou.Framework.SourceRootRegistration.N$(_MeziantouSourceRootNamespaceHash)</_MeziantouSourceRootNamespace>
      <_MeziantouSourceRootInitializerMethodName>Initialize$(_MeziantouSourceRootNamespaceHash)</_MeziantouSourceRootInitializerMethodName>
    </PropertyGroup>

    <!--
      The paths are written as C# verbatim string literals, so the only character to escape is the double quote.
      They must not be embedded in a quoted property function argument, as a path containing an apostrophe would break the
      expression. Item functions operate on the item value directly.
    -->
    <ItemGroup>
      <_MeziantouSourceRoot Include="@(SourceRoot->Replace('\', '/')->Replace('%22', '%22%22'))"
          Condition="'%(SourceRoot.NestedRoot)' == '' and '%(SourceRoot.MappedPath)' != ''" />
    </ItemGroup>

    <ItemGroup>
      <_MeziantouSourceRootRegistrationLines
          Include="@(_MeziantouSourceRoot->'        $(_MeziantouSourceRootRegistrationMethod)(@%22%(MappedPath)%22, @%22%(Identity)%22)%3B')" />
    </ItemGroup>

    <ItemGroup Condition="'@(_MeziantouSourceRootRegistrationLines)' != ''">
      <_MeziantouSourceRootFileLines Include="// &lt;auto-generated/&gt;" />
      <_MeziantouSourceRootFileLines Include="#pragma warning disable" />
      <_MeziantouSourceRootFileLines Include="using System.Runtime.CompilerServices%3B" />
      <_MeziantouSourceRootFileLines Include=" " />
      <_MeziantouSourceRootFileLines Include="[assembly: System.Reflection.AssemblyMetadata(%22$(_MeziantouSourceRootAssemblyMetadataName)%22, %22generated%22)]" />
      <_MeziantouSourceRootFileLines Include=" " />
      <_MeziantouSourceRootFileLines Include="namespace $(_MeziantouSourceRootNamespace)%3B" />
      <_MeziantouSourceRootFileLines Include=" " />
      <_MeziantouSourceRootFileLines Include="[System.CodeDom.Compiler.GeneratedCode(%22Meziantou.Framework.SourceRootRegistration%22, %22%22)]" />
      <_MeziantouSourceRootFileLines Include="internal static partial class $(_MeziantouSourceRootInitializerClassName)" />
      <_MeziantouSourceRootFileLines Include="{" />
      <_MeziantouSourceRootFileLines Include="    [ModuleInitializer]" />
      <_MeziantouSourceRootFileLines Include="    internal static void $(_MeziantouSourceRootInitializerMethodName)()" />
      <_MeziantouSourceRootFileLines Include="    {" />
      <_MeziantouSourceRootFileLines Include="@(_MeziantouSourceRootRegistrationLines)" />
      <_MeziantouSourceRootFileLines Include="    }" />
      <_MeziantouSourceRootFileLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile
        File="$(_MeziantouSourceRootFile)"
        Lines="@(_MeziantouSourceRootFileLines)"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
        Condition="'@(_MeziantouSourceRootFileLines)' != ''" />

    <ItemGroup Condition="'@(_MeziantouSourceRootFileLines)' != ''">
      <Compile Include="$(_MeziantouSourceRootFile)" />
      <EmbedInBinlog Include="$(_MeziantouSourceRootFile)" />
    </ItemGroup>

    <ItemGroup>
      <_MeziantouSourceRoot Remove="@(_MeziantouSourceRoot)" />
      <_MeziantouSourceRootRegistrationLines Remove="@(_MeziantouSourceRootRegistrationLines)" />
      <_MeziantouSourceRootFileLines Remove="@(_MeziantouSourceRootFileLines)" />
    </ItemGroup>
  </Target>
</Project>
