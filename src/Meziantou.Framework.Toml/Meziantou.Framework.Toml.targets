<Project>
  <PropertyGroup>
    <!--
      Feature switches for trimming / NativeAOT.

      Meziantou.Framework.Toml follows the "feature switches" guidance from dotnet/runtime:
      - values are provided to the runtime via runtimeconfig.json using RuntimeHostConfigurationOption
      - values are also provided to the trimmer when Trim="true"
    -->

    <!--
      By default, disable reflection-based serialization when publishing with NativeAOT.
      Consumers can override by setting MeziantouFrameworkTomlIsReflectionEnabledByDefault explicitly.
    -->
    <MeziantouFrameworkTomlIsReflectionEnabledByDefault Condition="'$(MeziantouFrameworkTomlIsReflectionEnabledByDefault)' == '' and ( '$(PublishAot)' == 'true' or '$(NativeAot)' == 'true' )">false</MeziantouFrameworkTomlIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(MeziantouFrameworkTomlIsReflectionEnabledByDefault)' != ''">
    <RuntimeHostConfigurationOption Include="Meziantou.Framework.Toml.TomlSerializer.IsReflectionEnabledByDefault"
                                   Value="$(MeziantouFrameworkTomlIsReflectionEnabledByDefault)"
                                   Trim="true" />
  </ItemGroup>
</Project>

