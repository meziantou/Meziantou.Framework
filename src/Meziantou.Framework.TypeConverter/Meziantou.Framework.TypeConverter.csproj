<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <!-- Converts culture names to CultureInfo -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsTrimmable>false</IsTrimmable>
    <Description>Convert objects to other types using all standard .NET ways to convert objects</Description>
    <PackageTags>type-converter, conversion, reflection, culture</PackageTags>
    <Version>4.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Meziantou.Framework/ReflectionUtilities.cs" Link="ReflectionUtilities.cs" />
  </ItemGroup>

</Project>
