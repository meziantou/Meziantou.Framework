<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework</RootNamespace>
    <Version>1.0.2</Version>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
    <Description>The word lists of ICU (Chinese and Japanese, Thai, Lao, Khmer and Burmese) and ports of the dictionary break engines of ICU, which find the words of the scripts that are written without spaces between words.</Description>
    <PackageTags>unicode, icu, word-break, segmentation, dictionary, thai, lao, khmer, burmese, chinese, japanese</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Unicode.Dictionaries.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Unicode.Dictionaries.Generator" />
  </ItemGroup>

  <ItemGroup>
    <!-- The word lists of ICU, one resource per list, generated by tools/Meziantou.Framework.Unicode.Dictionaries.Generator -->
    <EmbeddedResource Include="Data/*.dict" LogicalName="Meziantou.Framework.Unicode.Dictionaries.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.Unicode/Meziantou.Framework.Unicode.csproj" />
  </ItemGroup>

</Project>
