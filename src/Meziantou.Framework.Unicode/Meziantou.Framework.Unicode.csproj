<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework</RootNamespace>
    <Version>2.0.7</Version>
    <IsTrimmable>true</IsTrimmable>
    <Description>Unicode character properties (scripts, line breaking, segmentation, bidirectional, shaping), confusable detection and character metadata.</Description>
    <PackageTags>unicode, confusables, homoglyph, normalization, text, script, bidi, line-break, grapheme</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../common/GlobalizationHelper.cs" Link="GlobalizationHelper.cs" />
    <InternalsVisibleTo Include="Meziantou.Framework.Unicode.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/UnicodeData.bin">
      <LogicalName>Meziantou.Framework.Resources.UnicodeData.bin</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
