<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework</RootNamespace>
    <Version>2.0.17</Version>
    <Description>Unicode text algorithms that do not depend on the runtime or on ICU: character properties, case mappings, grapheme, word, sentence and line segmentation, normalization, bidirectional algorithm, script runs, hyphenation, internationalized domain names (IDNA) and confusable detection.</Description>
    <PackageTags>unicode, confusables, homoglyph, normalization, text, script, bidi, line-break, grapheme, hyphenation, idna, punycode</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- UnicodeResources reads the tables in place, through the address of the embedded resources -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Unicode.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.Unicode.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tables of the *.g.cs files, generated by tools/Meziantou.Framework.Unicode.Generator: .bin files are read in
         place, .deflate files are compressed with Deflate and decompressed on first use -->
    <EmbeddedResource Include="Data/*.bin;Data/*.deflate" LogicalName="Meziantou.Framework.Unicode.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
