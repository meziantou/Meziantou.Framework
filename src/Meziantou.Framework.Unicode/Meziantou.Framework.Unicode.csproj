<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework</RootNamespace>
    <Version>2.0.4</Version>
    <IsTrimmable>true</IsTrimmable>
    <Description>Unicode helpers for confusable character normalization and character metadata.</Description>
    <PackageTags>unicode, confusables, homoglyph, normalization, text</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../common/GlobalizationHelper.cs" Link="GlobalizationHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/UnicodeData.bin">
      <LogicalName>Meziantou.Framework.Resources.UnicodeData.bin</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
