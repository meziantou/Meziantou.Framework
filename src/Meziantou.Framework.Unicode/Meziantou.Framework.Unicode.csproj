<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework</RootNamespace>
    <Version>2.0.7</Version>
    <IsTrimmable>true</IsTrimmable>
    <Description>Unicode text algorithms that do not depend on the runtime or on ICU: character properties, grapheme, word and line segmentation, normalization, bidirectional algorithm, script runs, hyphenation and confusable detection.</Description>
    <PackageTags>unicode, confusables, homoglyph, normalization, text, script, bidi, line-break, grapheme, hyphenation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Unicode.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/UnicodeData.bin">
      <LogicalName>Meziantou.Framework.Resources.UnicodeData.bin</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
