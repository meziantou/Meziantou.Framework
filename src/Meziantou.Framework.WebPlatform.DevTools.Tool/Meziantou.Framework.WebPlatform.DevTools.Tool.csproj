<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsTrimmable>false</IsTrimmable>
    <RootNamespace>Meziantou.Framework.WebPlatform.DevToolsTool</RootNamespace>

    <Version>1.0.0</Version>
    <Description>CLI that runs a Chrome DevTools Protocol server whose browser is Meziantou.Framework.WebPlatform: Playwright (connectOverCDP), Puppeteer and the other CDP clients connect to it as to a headless Chromium</Description>
    <PackageTags>devtools, cdp, chrome-devtools-protocol, playwright, puppeteer, browser, automation, testing, cli, dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.WebPlatform.DevTools/Meziantou.Framework.WebPlatform.DevTools.csproj" />
  </ItemGroup>

</Project>
