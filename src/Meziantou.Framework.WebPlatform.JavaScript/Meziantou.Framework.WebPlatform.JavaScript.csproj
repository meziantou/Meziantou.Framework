<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.WebPlatform.JavaScript</RootNamespace>
    <Version>1.0.3</Version>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
    <Description>Runs the scripts of the documents of Meziantou.Framework.WebPlatform with Meziantou.Framework.JavaScriptEngine (a ScriptEngine with the WebIDL bindings of the DOM).</Description>
    <PackageTags>html;dom;javascript;ecmascript</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meziantou.Framework.JavaScriptEngine\Meziantou.Framework.JavaScriptEngine.csproj" />
    <ProjectReference Include="..\Meziantou.Framework.WebPlatform\Meziantou.Framework.WebPlatform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Wpt" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Benchmarks" />
  </ItemGroup>

  <!-- The package uses the internal hosting primitives of the core: it depends on the exact version of the core package -->
  <Target Name="UseExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReferencesWithVersions Include="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferencesWithVersions)" />
    </ItemGroup>
  </Target>
</Project>
