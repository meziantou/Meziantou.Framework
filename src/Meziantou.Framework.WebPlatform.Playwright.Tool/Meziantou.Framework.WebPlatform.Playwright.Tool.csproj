<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsTrimmable>false</IsTrimmable>
    <RootNamespace>Meziantou.Framework.WebPlatform.PlaywrightTool</RootNamespace>

    <Version>1.0.0</Version>
    <Description>CLI that runs a Playwright server whose browser is Meziantou.Framework.WebPlatform: the Playwright clients connect to it with BrowserType.ConnectAsync</Description>
    <PackageTags>playwright, browser, automation, testing, cli, dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Meziantou.Framework.WebPlatform.Playwright/Meziantou.Framework.WebPlatform.Playwright.csproj" />
  </ItemGroup>

</Project>
