<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsBrowserCompatible>false</IsBrowserCompatible>
    <RootNamespace>Meziantou.Framework.WebPlatform</RootNamespace>
    <Version>1.0.17</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every public member is documented (CS1591). The parameters do not have to be documented (CS1573). -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <!-- The nullable attributes of the private members are not emitted: they make the assembly bigger, and no caller reads them -->
    <Features>$(Features);nullablePublicOnly</Features>
    <Description>Spec-compliant HTML, XML, SVG and CSS parser exposing the browser DOM API (WHATWG DOM, HTML, URL, Encoding, Selectors, CSSOM, DOM XPath).</Description>
    <PackageTags>html;xml;svg;mathml;css;dom;parser;selectors;xpath;cssom;layout;web-platform</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Meziantou.Framework.WebPlatform.Html" />
    <!-- The types of the MATH table of the font reader, which the MathML layout uses -->
    <Using Include="Meziantou.Framework.Fonts.MathConstant" Alias="MathConstant" />
    <Using Include="Meziantou.Framework.Fonts.MathGlyphConstruction" Alias="MathGlyphConstruction" />
    <Using Include="Meziantou.Framework.Fonts.MathGlyphPart" Alias="MathGlyphPart" />
    <Using Include="Meziantou.Framework.Fonts.MathGlyphVariant" Alias="MathGlyphVariant" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Benchmarks" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Wpt" />
    <!-- The fuzzing targets of the internal readers (e.g. the font reader) -->
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Fuzz" />
    <!-- The script engine packages of this repository use the internal hosting primitives, and depend on the exact version of the core -->
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.JavaScript" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Wasm" />
    <!-- The rendering backend packages implement the internal rasterization services (the display list, the surfaces, the images) -->
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Imaging" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Imaging.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.PdfRendering" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.PdfRendering.Tests" />
    <!-- The DevTools protocol server reads the session history and sets the files of the file inputs -->
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.DevTools" />
    <!-- The HTML sanitizer copies the attributes it keeps in one pass -->
    <InternalsVisibleTo Include="Meziantou.Framework.HtmlSanitizer" />
  </ItemGroup>
  <ItemGroup>
    <!-- The scripts of the WebIDL bindings; the build compresses them (WebIdlRealm.LoadEmbeddedScript reads them) -->
    <EmbeddedResource Include="Scripting\WebIdl\*.js" LogicalName="Meziantou.Framework.WebPlatform.Scripting.WebIdl.%(Filename)%(Extension)" Compression="Deflate" />
    <!-- The bundled fonts (see Css/Fonts/Bundled/README.md); their licenses are distributed with the package. The build
         compresses the TrueType fonts; the WOFF2 fonts are compressed already -->
    <EmbeddedResource Include="Css\Fonts\Bundled\*.ttf" LogicalName="Meziantou.Framework.WebPlatform.Css.Fonts.Bundled.%(Filename)%(Extension)" Compression="Deflate" />
    <EmbeddedResource Include="Css\Fonts\Bundled\*.woff2" LogicalName="Meziantou.Framework.WebPlatform.Css.Fonts.Bundled.%(Filename)%(Extension)" />
    <!-- Reads the resources the build compresses (Compression="Deflate") -->
    <Compile Include="../../common/CompressedResource.cs" Link="Utils/CompressedResource.cs" />
    <None Include="Css\Fonts\Bundled\*.txt;Css\Fonts\Bundled\README.md" Pack="true" PackagePath="fonts/%(Filename)%(Extension)" />
    <!-- The encoding detector is a port of chardetng (Apache-2.0 or MIT license): its notice is distributed with the package -->
    <None Include="Encodings\chardetng-COPYRIGHT.txt" Pack="true" PackagePath="licenses/%(Filename)%(Extension)" />
    <!-- The hyphenation dictionaries (see Unicode/Hyphenation/README.md); their licenses are distributed with the package -->
    <EmbeddedResource Include="Unicode\Hyphenation\*.hyph" LogicalName="Meziantou.Framework.WebPlatform.Unicode.Hyphenation.%(Filename)%(Extension)" />
    <None Include="Unicode\Hyphenation\LICENSES.txt;Unicode\Hyphenation\README.md" Pack="true" PackagePath="hyphenation/%(Filename)%(Extension)" />
    <!-- The model of the Japanese phrases (data of ICU, see Unicode/Segmentation/README.md); its license is distributed with the package -->
    <None Include="Unicode\Segmentation\LICENSES.txt;Unicode\Segmentation\README.md" Pack="true" PackagePath="segmentation/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The font reader and the shaper, shared with Meziantou.Framework.Imaging; their API is internal -->
    <ProjectReference Include="..\Meziantou.Framework.Fonts\Meziantou.Framework.Fonts.csproj" />
    <!-- SHA-3, SHAKE, cSHAKE, KMAC, TurboSHAKE, KangarooTwelve and Argon2 of the Web Cryptography API -->
    <ProjectReference Include="..\Meziantou.Framework.Hashing\Meziantou.Framework.Hashing.csproj" />
    <!-- The properties of the code points, the normalization, the case mappings and IDNA (independent of the OS and ICU) -->
    <ProjectReference Include="..\Meziantou.Framework.Unicode\Meziantou.Framework.Unicode.csproj" />
    <!-- The word lists and the dictionary break engines of ICU (the lexical word breaking of the Southeast Asian scripts) -->
    <ProjectReference Include="..\Meziantou.Framework.Unicode.Dictionaries\Meziantou.Framework.Unicode.Dictionaries.csproj" />
    <!-- The WebTransport sessions of HttpDocumentLoader (HTTP/3 over MsQuic) -->
    <ProjectReference Include="..\Meziantou.Framework.WebTransport\Meziantou.Framework.WebTransport.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);MEZIANTOU_FRAMEWORK_WEBPLATFORM</DefineConstants>
  </PropertyGroup>
  <!--
    [IdlInterface], [IdlMember] and [NotInIdl] are [Conditional("WEBPLATFORM_IDL_METADATA")], so the published assembly does
    not carry them (about 1 MB). SpecGen and IdlCoverageTests read them by reflection: they reference the build that sets
    WebPlatformIdlMetadata=true, which defines the symbol. This build has its own output directories, does not generate the
    public API (ref/), and does not pass the property to the referenced projects, which are built only once.
  -->
  <PropertyGroup Condition="'$(WebPlatformIdlMetadata)' == 'true'">
    <DefineConstants>$(DefineConstants);WEBPLATFORM_IDL_METADATA</DefineConstants>
    <ArtifactsPivots>$(Configuration.ToLowerInvariant())_idlmetadata</ArtifactsPivots>
    <ArtifactsPivots Condition="'$(TargetFramework)' != ''">$(ArtifactsPivots)_$(TargetFramework.ToLowerInvariant())</ArtifactsPivots>
    <PublicApiGeneratorGenerateOnBuild>false</PublicApiGeneratorGenerateOnBuild>
    <PublicApiGeneratorVerifyNoChangeOnBuild>false</PublicApiGeneratorVerifyNoChangeOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Zstandard decoder of Meziantou.Framework.Imaging (the "dcz" content coding of the compression dictionaries) -->
    <Compile Include="../Meziantou.Framework.Imaging/Internals/Compression/ZstdDecoder.cs" Link="Compression/Shared/ZstdDecoder.cs" />
    <Compile Include="../Meziantou.Framework.Imaging/Internals/Compression/XxHash64.cs" Link="Compression/Shared/XxHash64.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The HSTS preload list of Meziantou.Framework.Http.Hsts (see Dom/Fetch/StrictTransportSecurity.cs). It is compiled
         here rather than referenced: that package converts internationalized domain names with IdnMapping, so it is
         globalization sensitive, while the hosts of WebPlatform are already ASCII. The resource is read in place, so it is
         not compressed -->
    <Compile Include="../Meziantou.Framework.Http.Hsts/HstsPreloadList.cs" Link="Dom/Fetch/Shared/HstsPreloadList.cs" />
    <Compile Include="../Meziantou.Framework.Http.Hsts/HstsPreloadList.g.cs" Link="Dom/Fetch/Shared/HstsPreloadList.g.cs" />
    <EmbeddedResource Include="../Meziantou.Framework.Http.Hsts/preload.bin" LogicalName="preload.bin" Link="Dom/Fetch/Shared/preload.bin" />
  </ItemGroup>
  <ItemGroup>
    <!-- Adler32 is only available from 11.0 -->
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Meziantou.Framework.WebPlatform.Analyzers\Meziantou.Framework.WebPlatform.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>
  <!--
    An item definition, not an Update: it also applies to the references that Directory.Build.targets adds after this file
    (the analyzers), which would otherwise be built twice in the same directory
  -->
  <ItemDefinitionGroup Condition="'$(WebPlatformIdlMetadata)' == 'true'">
    <ProjectReference>
      <GlobalPropertiesToRemove>WebPlatformIdlMetadata</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
</Project>
