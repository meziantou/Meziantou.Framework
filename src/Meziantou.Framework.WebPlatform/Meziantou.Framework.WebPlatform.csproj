<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.WebPlatform</RootNamespace>
    <Version>1.0.3</Version>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every public member is documented (CS1591). The parameters do not have to be documented (CS1573). -->
    <DisableDocumentationWarnings>false</DisableDocumentationWarnings>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <Description>Spec-compliant HTML, XML, SVG and CSS parser exposing the browser DOM API (WHATWG DOM, HTML, URL, Encoding, Selectors, CSSOM, DOM XPath).</Description>
    <PackageTags>html;xml;svg;mathml;css;dom;parser;selectors;xpath;cssom;layout;web-platform</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Meziantou.Framework.WebPlatform.Html" />
    <!-- The types of the MATH table of the font reader, which the MathML layout uses -->
    <Using Include="Meziantou.Framework.Fonts.MathConstant" Alias="MathConstant" />
    <Using Include="Meziantou.Framework.Fonts.MathGlyphConstruction" Alias="MathGlyphConstruction" />
    <Using Include="Meziantou.Framework.Fonts.MathGlyphPart" Alias="MathGlyphPart" />
    <Using Include="Meziantou.Framework.Fonts.MathGlyphVariant" Alias="MathGlyphVariant" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Benchmarks" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Wpt" />
    <!-- The fuzzing targets of the internal readers (e.g. the font reader) -->
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Fuzz" />
    <!-- The script engine packages of this repository use the internal hosting primitives, and depend on the exact version of the core -->
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.JavaScript" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Wasmtime" />
    <!-- The rendering backend packages implement the internal rasterization services (the display list, the surfaces, the images) -->
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Imaging" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.Imaging.Tests" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.PdfRendering" />
    <InternalsVisibleTo Include="Meziantou.Framework.WebPlatform.PdfRendering.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripting\WebIdl\Streams.js" LogicalName="Meziantou.Framework.WebPlatform.Scripting.WebIdl.Streams.js" />
    <EmbeddedResource Include="Scripting\WebIdl\Fetch.js" LogicalName="Meziantou.Framework.WebPlatform.Scripting.WebIdl.Fetch.js" />
    <EmbeddedResource Include="Scripting\WebIdl\WebCrypto.js" LogicalName="Meziantou.Framework.WebPlatform.Scripting.WebIdl.WebCrypto.js" />
    <EmbeddedResource Include="Scripting\WebIdl\CacheStorage.js" LogicalName="Meziantou.Framework.WebPlatform.Scripting.WebIdl.CacheStorage.js" />
    <!-- The bundled fonts (see Css/Fonts/Bundled/README.md); their licenses are distributed with the package -->
    <EmbeddedResource Include="Css\Fonts\Bundled\*.ttf;Css\Fonts\Bundled\*.woff2" LogicalName="Meziantou.Framework.WebPlatform.Css.Fonts.Bundled.%(Filename)%(Extension)" />
    <None Include="Css\Fonts\Bundled\*.txt;Css\Fonts\Bundled\README.md" Pack="true" PackagePath="fonts/%(Filename)%(Extension)" />
    <!-- The encoding detector is a port of chardetng (Apache-2.0 or MIT license): its notice is distributed with the package -->
    <None Include="Encodings\chardetng-COPYRIGHT.txt" Pack="true" PackagePath="licenses/%(Filename)%(Extension)" />
    <!-- The hyphenation dictionaries (see Unicode/Hyphenation/README.md); their licenses are distributed with the package -->
    <EmbeddedResource Include="Unicode\Hyphenation\*.hyph" LogicalName="Meziantou.Framework.WebPlatform.Unicode.Hyphenation.%(Filename)%(Extension)" />
    <None Include="Unicode\Hyphenation\LICENSES.txt;Unicode\Hyphenation\README.md" Pack="true" PackagePath="hyphenation/%(Filename)%(Extension)" />
    <!-- The model of the Japanese phrases (data of ICU, see Unicode/Segmentation/README.md); its license is distributed with the package -->
    <None Include="Unicode\Segmentation\LICENSES.txt;Unicode\Segmentation\README.md" Pack="true" PackagePath="segmentation/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The font reader and the shaper, shared with Meziantou.Framework.Imaging; their API is internal -->
    <ProjectReference Include="..\Meziantou.Framework.Fonts\Meziantou.Framework.Fonts.csproj" />
    <!-- The properties of the code points, the normalization, the case mappings and IDNA (independent of the OS and ICU) -->
    <ProjectReference Include="..\Meziantou.Framework.Unicode\Meziantou.Framework.Unicode.csproj" />
    <!-- The word lists and the dictionary break engines of ICU (the lexical word breaking of the Southeast Asian scripts) -->
    <ProjectReference Include="..\Meziantou.Framework.Unicode.Dictionaries\Meziantou.Framework.Unicode.Dictionaries.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Adler32 is only available from 11.0 -->
    <PackageReference Include="System.IO.Hashing" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Meziantou.Framework.WebPlatform.Analyzers\Meziantou.Framework.WebPlatform.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <!-- The library is released together with Meziantou.Framework.Fonts: it depends on the exact version of that package -->
  <Target Name="UseExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReferencesWithVersions Include="@(_ProjectReferencesWithVersions)" Condition="'%(Filename)' == 'Meziantou.Framework.Fonts'" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
      <_ProjectReferencesWithVersions Remove="@(_ExactProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferencesWithVersions)" />
    </ItemGroup>
  </Target>
</Project>
