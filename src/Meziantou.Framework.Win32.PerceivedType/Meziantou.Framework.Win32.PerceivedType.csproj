<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsBrowserCompatible>false</IsBrowserCompatible>
    <IsTrimmable>false</IsTrimmable>
    <Description>Determine the perceived type of a file (text, image, audio, video, and so on) from its extension using Windows APIs</Description>
    <PackageTags>windows, win32, perceived-type, file-type, shell</PackageTags>
    <Version>4.0.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Framework.Win32.PerceivedType.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../common/Win32/Windows.Win32.Foundation.HRESULT.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.Foundation.PCWSTR.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.Foundation.PWSTR.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.PInvoke.AssocGetPerceivedType.g.cs" LinkBase="Win32" />
    <Compile Include="../../common/Win32/Windows.Win32.UI.Shell.Common.PERCEIVED.g.cs" LinkBase="Win32" />
  </ItemGroup>

</Project>
