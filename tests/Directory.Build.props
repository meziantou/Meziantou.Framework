<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <EnableCodeCoverage>false</EnableCodeCoverage>
    <!-- Platform-specific test projects skip all their tests on the other platforms -->
    <MinimumExpectedTests>0</MinimumExpectedTests>
    <IncludeDefaultTestReferences Condition="'$(IncludeDefaultTestReferences)' == ''">true</IncludeDefaultTestReferences>
    <DefineConstants Condition="'$(GITHUB_ACTIONS)' == 'true'">$(DefineConstants);GITHUB_ACTIONS</DefineConstants>
    <TestTfmsInParallel Condition="'$(GITHUB_ACTIONS)' == 'true' AND $([MSBuild]::IsOsPlatform('Windows'))">false</TestTfmsInParallel>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeDefaultTestReferences)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../common/XUnitStaticHelpers.cs" Link="XUnitStaticHelpers.cs" Condition="'$(MSBuildProjectExtension)' == '.csproj'" Visible="false" />

    <Using Include="Xunit.TestContext" Alias="TestContext" />
    <Using Include="TestUtilities.XUnitStaticHelpers" Static="true" />

    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Meziantou.Xunit/Meziantou.Xunit.csproj" />

    <Using Include="Meziantou.Framework.Assertions" />
    <Using Include="Meziantou.Framework.Assertions.Assert" Alias="Assert" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Meziantou.Framework.Assertions/Meziantou.Framework.Assertions.csproj" />
  </ItemGroup>

</Project>
