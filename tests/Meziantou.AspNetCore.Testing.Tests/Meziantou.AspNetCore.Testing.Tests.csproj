<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A Blazor Web App is one of the applications under test: the Web SDK compiles its components and serves blazor.web.js -->
  <Sdk Name="Meziantou.NET.Sdk.Test" />

  <!-- Maps the deterministic source paths, so the snapshots are found in the Release builds -->
  <Import Project="../../src/Meziantou.Framework.SnapshotTesting/build/Meziantou.Framework.SnapshotTesting.targets" />

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- The test components let the errors of the JavaScript calls fail the tests -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
    <WasmAppProject>$(MSBuildThisFileDirectory)../Meziantou.AspNetCore.Testing.WasmApp/Meziantou.AspNetCore.Testing.WasmApp.csproj</WasmAppProject>
    <WasmAppPublishDir>$(ArtifactsPath)/publish/Meziantou.AspNetCore.Testing.WasmApp/$(Configuration)_$(TargetFramework)/</WasmAppPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.AspNetCore.Testing/Meziantou.AspNetCore.Testing.csproj" />
    <!-- The screenshots are compared with snapshot files -->
    <ProjectReference Include="../../src/Meziantou.Framework.SnapshotTesting/Meziantou.Framework.SnapshotTesting.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.SnapshotTesting.Imaging/Meziantou.Framework.SnapshotTesting.Imaging.csproj" />
    <!-- The application of the end-to-end tests, opened with WebApplicationFactory<Program> -->
    <ProjectReference Include="../Meziantou.AspNetCore.Testing.TestApp/Meziantou.AspNetCore.Testing.TestApp.csproj" />
    <!-- The Blazor WebAssembly application of the end-to-end tests: its published files are served to the pages, and its
         runtime runs on Wasmtime. The reference only orders the builds. -->
    <ProjectReference Include="$(WasmAppProject)" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Meziantou.Framework.WebPlatform.Wasmtime/Meziantou.Framework.WebPlatform.Wasmtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="WasmAppPath" Value="$(WasmAppPublishDir)wwwroot" />
  </ItemGroup>

  <Target Name="PublishWasmApp" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' AND '$(TargetFramework)' != ''">
    <MSBuild Projects="$(WasmAppProject)" Targets="Publish" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(WasmAppPublishDir)" />
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
  </ItemGroup>

</Project>
