<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A Blazor Web App is one of the applications under test: the Web SDK compiles its components and serves blazor.web.js -->
  <Sdk Name="Meziantou.NET.Sdk.Test" />

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- The test components let the errors of the JavaScript calls fail the tests -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.AspNetCore.Testing/Meziantou.AspNetCore.Testing.csproj" />
    <!-- The screenshots are compared with snapshot files -->
    <ProjectReference Include="../../src/Meziantou.Framework.SnapshotTesting/Meziantou.Framework.SnapshotTesting.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.SnapshotTesting.Imaging/Meziantou.Framework.SnapshotTesting.Imaging.csproj" />
    <!-- The application of the end-to-end tests, opened with WebApplicationFactory<Program> -->
    <ProjectReference Include="../Meziantou.AspNetCore.Testing.TestApp/Meziantou.AspNetCore.Testing.TestApp.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
  </ItemGroup>

</Project>
