<Project Sdk="Meziantou.NET.Sdk.Test">

  <PropertyGroup>
    <!-- Formats values with named cultures -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Assertions.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles the assemblies read by the architecture tests -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Only used as an oracle by the architecture differential tests: the library itself does not use Mono.Cecil -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.Assertions/Meziantou.Framework.Assertions.csproj" />
  </ItemGroup>

</Project>
