<Project Sdk="Meziantou.NET.Sdk.Test">

  <Import Project="../../src/Meziantou.Framework.SnapshotTesting/build/Meziantou.Framework.SnapshotTesting.targets" />

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Barcodes.Tests</RootNamespace>
    <!-- The decoders take module matrices, as the generators return them -->
    <NoWarn>$(NoWarn);CA1814</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.Barcodes/Meziantou.Framework.Barcodes.csproj" />
    <!-- The PNG snapshots of the scenes, drawn by the image renderer -->
    <ProjectReference Include="../../src/Meziantou.Framework.Imaging.Barcodes/Meziantou.Framework.Imaging.Barcodes.csproj" />
    <!-- The PDF example: the scenes are drawn by every scene renderer -->
    <ProjectReference Include="../../src/Meziantou.Framework.Pdf.VectorGraphics/Meziantou.Framework.Pdf.VectorGraphics.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.InlineSnapshotTesting/Meziantou.Framework.InlineSnapshotTesting.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.SnapshotTesting/Meziantou.Framework.SnapshotTesting.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.SnapshotTesting.Imaging/Meziantou.Framework.SnapshotTesting.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Meziantou.Framework.VectorGraphics" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests of the reference linters of the GS1 Barcode Syntax Dictionary (see Gs1/README.md) -->
    <EmbeddedResource Include="Gs1\gs1-linter-tests.json" LogicalName="Meziantou.Framework.Barcodes.Tests.gs1-linter-tests.json" />
  </ItemGroup>

</Project>
