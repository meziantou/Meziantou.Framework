  "expected": [
   {
    "a": "1",
    "b": "2",
    "c": "3"
   },
   {
    "a": "Once upon \r\na time",
    "b": "5",
    "c": "6"
   },
   {
    "a": "7",
    "b": "8",
    "c": "9"
   }
  ]
 },
 {
  "name": "quotes_and_newlines",
  "csv": "a,b\n1,\"ha \n\"\"ha\"\" \nha\"\n3,4\n",
