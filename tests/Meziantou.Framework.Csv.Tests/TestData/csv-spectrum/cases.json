[
 {
  "name": "comma_in_quotes",
  "csv": "first,last,address,city,zip\nJohn,Doe,120 any st.,\"Anytown, WW\",08123",
  "expected": [
   {
    "first": "John",
    "last": "Doe",
    "address": "120 any st.",
    "city": "Anytown, WW",
    "zip": "08123"
   }
  ]
 },
 {
  "name": "empty",
  "csv": "a,b,c\n1,\"\",\"\"\n2,3,4",
  "expected": [
   {
    "a": "1",
    "b": "",
    "c": ""
   },
   {
    "a": "2",
    "b": "3",
    "c": "4"
   }
  ]
 },
 {
  "name": "empty_crlf",
  "csv": "a,b,c\r\n1,\"\",\"\"\r\n2,3,4",
  "expected": [
   {
    "a": "1",
    "b": "",
    "c": ""
   },
   {
    "a": "2",
    "b": "3",
    "c": "4"
   }
  ]
 },
 {
  "name": "escaped_quotes",
  "csv": "a,b\n1,\"ha \"\"ha\"\" ha\"\n3,4\n",
  "expected": [
   {
    "a": "1",
    "b": "ha \"ha\" ha"
   },
   {
    "a": "3",
    "b": "4"
   }
  ]
 },
 {
  "name": "json",
  "csv": "key,val\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [102.0, 0.5]}\"\n",
  "expected": [
   {
    "key": "1",
    "val": "{\"type\": \"Point\", \"coordinates\": [102.0, 0.5]}"
   }
  ]
 },
 {
