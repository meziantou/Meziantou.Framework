<Project Sdk="Meziantou.NET.Sdk.Test">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bundle of the tests of Meziantou.Framework.Geo.Maps, copied to a maps folder next to the tests, as the packages of bundles do -->
    <None Include="../Meziantou.Framework.Geo.Maps.Tests/TestData/maps/*/**" Link="maps/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.Geo.Maps.GeoPackage/Meziantou.Framework.Geo.Maps.GeoPackage.csproj" />
  </ItemGroup>

</Project>
