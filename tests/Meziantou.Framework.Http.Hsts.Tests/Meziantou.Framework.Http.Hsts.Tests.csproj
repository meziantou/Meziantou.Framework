<Project Sdk="Meziantou.NET.Sdk.Test">

  <PropertyGroup>
    <!-- Tests internationalized domain names -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.Http.Hsts/Meziantou.Framework.Http.Hsts.csproj" />
  </ItemGroup>

  <!-- The reviewable form of the preload data, so a test can check the whole of what the library loaded
       against it. -->
  <ItemGroup>
    <EmbeddedResource Include="../../src/Meziantou.Framework.Http.Hsts/preload-hosts.txt">
      <LogicalName>%(FileName)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
