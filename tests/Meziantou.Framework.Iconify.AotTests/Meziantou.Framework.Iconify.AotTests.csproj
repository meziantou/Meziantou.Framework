<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <!-- The namespace Meziantou.Framework.Iconify would clash with the Meziantou.Framework.Iconify class -->
    <RootNamespace>Meziantou.Framework.IconifyAotTests</RootNamespace>
    <!-- 'dotnet test' runs these tests on the JIT, so CI leaves the project out of the regular test jobs: the test_aot job of ci.yml publishes it and runs the native executable. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <!-- xUnit.net requires an apphost, but its package only sets UseAppHost once restored, whereas the SDK disables the apphost for Native AOT.
         The restore that does not see it yet would not download the apphost pack of a target framework that the SDK does not bundle,
         and the build then fails with MSB3030 on a machine that does not already have it. -->
    <UseAppHost>true</UseAppHost>

    <!-- Meziantou.Xunit extends the reflection-based xUnit.net packages and Meziantou.Framework.Assertions relies on reflection, so neither can be used in a Native AOT application -->
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.Iconify/Meziantou.Framework.Iconify.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.Iconify.SourceGenerator/Meziantou.Framework.Iconify.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="aot-icons.json" CopyToOutputDirectory="PreserveNewest" />
    <IconifyIconSet Include="aot-icons.json" ClassName="Aot" />
  </ItemGroup>

  <Import Project="../../src/Meziantou.Framework.Iconify/Meziantou.Framework.Iconify.targets" />
</Project>
