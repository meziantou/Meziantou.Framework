<Project Sdk="Meziantou.NET.Sdk.Test">
  <!-- Processing, resampling, convolution, automatic cropping, drawing and color conversion, with their golden and reference suites -->
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Imaging.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.Imaging\Meziantou.Framework.Imaging.csproj" />
    <ProjectReference Include="..\Meziantou.Framework.Imaging.TestHarness\Meziantou.Framework.Imaging.TestHarness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The expected values of ColorValueReferenceTests, and the scripts that compute them -->
    <EmbeddedResource Include="ColorValues/*.json;ColorValues/*.txt" LogicalName="ColorValues/%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\Meziantou.Framework.Imaging.Tests.Shared\Imaging.Tests.Shared.props" />
</Project>
