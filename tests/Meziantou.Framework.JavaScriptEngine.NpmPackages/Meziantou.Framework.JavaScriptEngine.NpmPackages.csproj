<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.JavaScriptEngine.NpmPackages</RootNamespace>
    <!-- Each workload runs in its own engine: the server GC keeps the parallel tests from pausing each other -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The workloads run in a page of Meziantou.Framework.WebPlatform, with the engine and Wasmtime -->
    <ProjectReference Include="../../src/Meziantou.Framework.JavaScriptEngine/Meziantou.Framework.JavaScriptEngine.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.WebPlatform/Meziantou.Framework.WebPlatform.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.WebPlatform.JavaScript/Meziantou.Framework.WebPlatform.JavaScript.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.WebPlatform.Wasmtime/Meziantou.Framework.WebPlatform.Wasmtime.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.FullPath/Meziantou.Framework.FullPath.csproj" />
  </ItemGroup>
</Project>
