<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.JavaScriptEngine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Corpus/*.jsonl" />
    <EmbeddedResource Include="Corpus/*.txt.gz" LogicalName="Corpus.%(Filename)%(Extension)" />
    <!-- Test data of CLDR (common/testData and common/uca of the CLDR release) -->
    <EmbeddedResource Include="Intl/TestData/*.gz" LogicalName="Intl.TestData.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.JavaScriptEngine/Meziantou.Framework.JavaScriptEngine.csproj" />
  </ItemGroup>
</Project>
