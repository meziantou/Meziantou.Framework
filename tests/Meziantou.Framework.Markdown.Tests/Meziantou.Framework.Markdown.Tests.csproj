<Project Sdk="Meziantou.NET.Sdk.Test">

  <PropertyGroup>
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Markdown.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.Markdown/Meziantou.Framework.Markdown.csproj" />
    <!-- The syntax tree the Markdown nodes are built on -->
    <Using Include="Meziantou.Framework.Language" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Specs/CommonMark.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Specs/GfmExtensions.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Specs/Extensions/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
