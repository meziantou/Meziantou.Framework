<Project Sdk="Meziantou.NET.Sdk.Test">

  <PropertyGroup>
    <!-- Formats dates with named cultures and time zones -->
    <GlobalizationSensitive>true</GlobalizationSensitive>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <RootNamespace>Meziantou.Framework.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.RelativeDate/Meziantou.Framework.RelativeDate.csproj" />
  </ItemGroup>

</Project>
