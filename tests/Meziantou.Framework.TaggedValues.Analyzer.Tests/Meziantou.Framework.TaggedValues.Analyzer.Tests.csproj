<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFramework)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.TaggedValues/Meziantou.Framework.TaggedValues.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.TaggedValues.Analyzer/Meziantou.Framework.TaggedValues.Analyzer.csproj" />
    <ProjectReference Include="../../src/Meziantou.Framework.TaggedValues.CodeFix/Meziantou.Framework.TaggedValues.CodeFix.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ReadmeExampleTests runs the analyzer on the readme examples -->
    <EmbeddedResource Include="../../samples/Meziantou.Framework.TaggedValues.Samples/**/*.cs" Exclude="../../samples/Meziantou.Framework.TaggedValues.Samples/obj/**;../../samples/Meziantou.Framework.TaggedValues.Samples/bin/**" LogicalName="ReadmeSamples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- Microsoft.CodeAnalysis.CSharp.Analyzer.Testing depends on a version vulnerable to GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>
</Project>
