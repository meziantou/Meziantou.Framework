  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../common/ConsoleHelper.cs" Link="ConsoleHelper.cs" />
  </ItemGroup>

  <!-- Templates of the documentation, and the files the tool must produce from them -->
