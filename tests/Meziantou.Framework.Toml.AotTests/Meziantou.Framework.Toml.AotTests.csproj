<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <!-- 'dotnet test' runs these tests on the JIT. The test_aot job of ci.yml publishes the project and runs the native executable. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>

    <!-- Meziantou.Xunit extends the reflection-based xUnit.net packages and Meziantou.Framework.Assertions relies on reflection, so neither can be used in a Native AOT application -->
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.Toml\Meziantou.Framework.Toml.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.Toml.SourceGenerator\Meziantou.Framework.Toml.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="twitter.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
