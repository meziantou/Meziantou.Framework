<Project Sdk="Meziantou.NET.Sdk.Test">

  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Meziantou.Framework.VectorGraphics.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- An OFL font for the tests of FontFaceTextMeasurer: the Liberation Sans subset of Meziantou.Framework.Pdf -->
    <None Include="../../src/Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationSans-Regular.woff2" Link="TestData/LiberationSans-Regular.woff2" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationSans-Italic.woff2" Link="TestData/LiberationSans-Italic.woff2" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationSans-Bold.woff2" Link="TestData/LiberationSans-Bold.woff2" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Meziantou.Framework.Pdf/Rendering/Fonts/Substitution/LiberationMono-Regular.woff2" Link="TestData/LiberationMono-Regular.woff2" CopyToOutputDirectory="PreserveNewest" />
    <!-- An OFL font with the Thai characters that Liberation Sans does not have, for the fallback between families -->
    <None Include="../Meziantou.Framework.Imaging.Fixtures/fonts/noto-sans-thai/NotoSansThai-Regular.ttf" Link="TestData/NotoSansThai-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meziantou.Framework.VectorGraphics/Meziantou.Framework.VectorGraphics.csproj" />
  </ItemGroup>

</Project>
