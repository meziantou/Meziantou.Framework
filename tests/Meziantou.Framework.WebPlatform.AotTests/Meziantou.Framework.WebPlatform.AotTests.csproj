<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <!-- 'dotnet test' runs these tests on the JIT, so CI leaves the project out of the regular test jobs: the test_aot job of ci.yml publishes it and runs the native executable. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- On macOS, dsymutil reports the Swift modules of the native cryptography library of .NET 10 that it cannot find as
         errors, which fails the publish: the symbols of the test executable are not needed -->
    <StripSymbols>false</StripSymbols>
    <!-- xUnit.net requires an apphost, but its package only sets UseAppHost once restored, whereas the SDK disables the apphost for Native AOT.
         The restore that does not see it yet would not download the apphost pack of a target framework that the SDK does not bundle,
         and the build then fails with MSB3030 on a machine that does not already have it. -->
    <UseAppHost>true</UseAppHost>

    <!-- Meziantou.Xunit extends the reflection-based xUnit.net packages and Meziantou.Framework.Assertions relies on reflection, so neither can be used in a Native AOT application -->
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>

    <!-- The trimming and AOT warnings of the libraries fail the publish -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <!-- IL2104/IL3053: the summary warnings of the third-party assemblies without trimming annotations (see below) -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <!-- The compiler still reports 3 IL2026 warnings of compiler-generated code of Jint (the closures of Options.Apply). The
         libraries of the repository are IsAotCompatible: their own IL2026 warnings are reported when they are compiled. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform\Meziantou.Framework.WebPlatform.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.Jint\Meziantou.Framework.WebPlatform.Jint.csproj" />
  </ItemGroup>

  <!-- Jint is not annotated for trimming: its warnings are reported as a single warning (suppressed above) instead of failing
       the publish. The script engine only uses the parts of Jint that do not depend on reflection (no CLR interop). -->
  <Target Name="SingleWarnForJint" BeforeTargets="PrepareForILLink;WriteIlcRspFileForCompilation" AfterTargets="_ComputeManagedAssemblyToLink">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'Jint'" TrimmerSingleWarn="true" />
    </ItemGroup>
  </Target>

  <!-- The compiler of .NET 11 reads the assemblies from ResolvedFileToPublish instead of ManagedAssemblyToLink -->
  <Target Name="SingleWarnForJintNet11" BeforeTargets="_ComputeIlcCompileInputs">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(Filename)%(Extension)' == 'Jint.dll'" TrimmerSingleWarn="true" />
    </ItemGroup>
  </Target>
</Project>
