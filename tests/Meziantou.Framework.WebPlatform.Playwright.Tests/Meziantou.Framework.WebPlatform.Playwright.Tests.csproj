<Project Sdk="Meziantou.NET.Sdk.Test">
  <!-- The tests of the Playwright server: the official Playwright client (Microsoft.Playwright) connects to the server -->
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <!-- The tests use the assertions of xUnit.net -->
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
    <!-- Test method names describe behavior with underscores -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The version of the client must have the major and minor versions of PlaywrightServer.PlaywrightVersion -->
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.Playwright\Meziantou.Framework.WebPlatform.Playwright.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
