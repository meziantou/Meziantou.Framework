<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <!-- The tests use the assertions of xUnit.net -->
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
    <!-- Test method names describe behavior with underscores -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.FullPath\Meziantou.Framework.FullPath.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform\Meziantou.Framework.WebPlatform.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.Jint\Meziantou.Framework.WebPlatform.Jint.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.JavaScript\Meziantou.Framework.WebPlatform.JavaScript.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.Wasmtime\Meziantou.Framework.WebPlatform.Wasmtime.csproj" />
    <ProjectReference Include="..\..\tools\Meziantou.Framework.WebPlatform.Analyzers\Meziantou.Framework.WebPlatform.Analyzers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Meziantou.Framework.Fonts.MathConstant" Alias="MathConstant" />
  </ItemGroup>
  <ItemGroup>
    <!-- The conformance files of the Unicode version of Meziantou.Framework.Unicode, written by tools/Meziantou.Framework.Unicode.Generator -->
    <EmbeddedResource Include="..\Meziantou.Framework.Unicode.Tests\files\BidiTest.txt.gz;..\Meziantou.Framework.Unicode.Tests\files\BidiCharacterTest.txt.gz;..\Meziantou.Framework.Unicode.Tests\files\GraphemeBreakTest.txt.gz;..\Meziantou.Framework.Unicode.Tests\files\LineBreakTest.txt.gz;..\Meziantou.Framework.Unicode.Tests\files\WordBreakTest.txt.gz" LogicalName="unicode/%(FileName)%(Extension)" Link="Unicode\files\%(FileName)%(Extension)" />
  </ItemGroup>
</Project>
