<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
    <!-- The tests use the assertions of xUnit.net -->
    <IncludeDefaultTestReferences>false</IncludeDefaultTestReferences>
    <!-- The tests run in parallel and allocate a lot: the workstation GC pauses all of them -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1031;CA1812;CA1859;CA1305;CA1307;CA1310;CA1309;CA2201;CA1062;CA1508;CA1869</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.FullPath\Meziantou.Framework.FullPath.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform\Meziantou.Framework.WebPlatform.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.JavaScript\Meziantou.Framework.WebPlatform.JavaScript.csproj" />
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.Wasmtime\Meziantou.Framework.WebPlatform.Wasmtime.csproj" />
    <!-- The rendering backend of the reftests (the core library does not reference it) -->
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform.Imaging\Meziantou.Framework.WebPlatform.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The IDL model of tools/Meziantou.Framework.WebPlatform.SpecGen, used by IdlCoverageTests -->
    <Compile Include="..\..\tools\Meziantou.Framework.WebPlatform.SpecGen\IdlModel.cs" Link="Idl\IdlModel.cs" />
    <Compile Include="..\..\tools\Meziantou.Framework.WebPlatform.SpecGen\BindingModel.cs" Link="Idl\BindingModel.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
