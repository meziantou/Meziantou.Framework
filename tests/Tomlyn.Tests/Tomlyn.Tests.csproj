<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFrameworks>$(LatestTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="files/toml-test/cases.json" LogicalName="Tomlyn.Tests.files.toml-test.cases.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The netstandard2.0 source generator depends on System.Text.Json 10, which needs a newer version than the one xunit references -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tomlyn\Tomlyn.csproj" />
    <ProjectReference Include="..\..\src\Tomlyn.SourceGeneration\Tomlyn.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>
</Project>
