<Project Sdk="Meziantou.NET.Sdk">
  <!--
    Transcribes the constant tables and the named constants of the AV1 Bitstream & Decoding Process Specification into the generated
    files of src/Meziantou.Framework.Imaging/Internals/Codecs/Avif/Av1/Tables. The specification sources are not committed: the tool
    reads a local copy pinned by commit and SHA-256 (see Program.cs). It is NEVER run by the build or the tests.
    Single target framework so that `dotnet run` needs no framework argument.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MinimumTargetFramework)</TargetFramework>
    <ValidateProjectTargets>false</ValidateProjectTargets>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Every emitted number is culture-independent -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      A one-purpose transcription tool rather than a product:
      MA0048 (one type per file): small records live next to the code that uses them;
      MA0051 (method length): the emitters are kept linear;
      CA1032, MA0009 (exception constructors, regex timeouts): internal types, trusted inputs.
    -->
    <NoWarn>$(NoWarn);MA0048;MA0051;CA1032;MA0009</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meziantou.Framework.FullPath\Meziantou.Framework.FullPath.csproj" />
  </ItemGroup>
</Project>
