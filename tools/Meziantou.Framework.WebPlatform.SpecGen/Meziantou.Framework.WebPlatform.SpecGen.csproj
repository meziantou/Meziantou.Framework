<Project Sdk="Meziantou.NET.Sdk">
  <!-- Generates the code of Meziantou.Framework.WebPlatform from the specification data (tests/Meziantou.Framework.WebPlatform.SpecData) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(LatestTargetFramework)</TargetFramework>
    <RootNamespace>SpecGen</RootNamespace>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA2007;CA1031;MA0011;CA1305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bindings generator reflects on the .NET members annotated with [IdlMember] -->
    <ProjectReference Include="..\..\src\Meziantou.Framework.WebPlatform\Meziantou.Framework.WebPlatform.csproj" />
  </ItemGroup>
</Project>
