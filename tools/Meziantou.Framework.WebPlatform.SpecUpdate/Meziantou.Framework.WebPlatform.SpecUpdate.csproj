<Project Sdk="Meziantou.NET.Sdk">
  <!-- Updates the specification data and fetches the external test suites of Meziantou.Framework.WebPlatform -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(LatestTargetFramework)</TargetFramework>
    <RootNamespace>SpecUpdate</RootNamespace>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA2007;CA1031</NoWarn>
  </PropertyGroup>
</Project>
